.DS_Store
node_modules/
*.log
.shopify/

# Escritos dirigidos a clientes concretos (cartas, requerimientos, denuncias).
#
# Llevan nombre, correo y domicilio de un particular, y en algun caso una
# imputacion de fraude. Un historial de git no se borra: una vez dentro, ese
# dato queda ahi para siempre y se copia con cada clon del repositorio.
# El fichero se genera, se entrega al usuario y se queda solo en su equipo.
# Cualquier extension: el PDF lleva exactamente los mismos datos que el .txt,
# y el patron anterior solo cubria .txt.
tienda/carta-*
tienda/denuncia-*

# Las facturas llevan nombre, domicilio y NIF del cliente: mismo motivo que
# las cartas. Se generan, se entregan y no entran nunca en el repositorio.
tienda/factura-*
tienda/recibo-*
tienda/justificante-*
