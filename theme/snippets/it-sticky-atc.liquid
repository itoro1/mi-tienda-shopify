{%- comment -%}
  Sticky bottom buy bar — mobile only (≤749px).
  SIEMPRE fija abajo (no se oculta al hacer scroll).

  La barra no decide nada por su cuenta: delega el click en el boton
  "Comprar ahora" que el formulario de producto tenga en ese momento. Asi no
  se queda apuntando a un nodo viejo cuando Dawn vuelve a pintar el formulario
  al cambiar de variante.

  Sin reservas (14/10/2026): antes, una variante a cero pintaba aqui
  "Bajo pedido · Reserva 50€". Ahora siempre es comprar; si no hay unidades
  solo cambia el plazo, que se ve bajo el precio.

  Accepts: product, section_id
{%- endcomment -%}
{%- liquid
  assign satc_variant = product.selected_or_first_available_variant | default: product.variants.first
  assign satc_pedido = false
  if satc_variant.inventory_management == 'shopify' and satc_variant.inventory_quantity <= 0
    assign satc_pedido = true
  endif
-%}
<style>
#it-satc{
  position:fixed;bottom:0;left:0;right:0;z-index:9800;
  display:flex;align-items:center;gap:12px;
  background:var(--it-surface,#fff);
  border-top:0.5px solid var(--it-border,rgba(0,0,0,.09));
  padding:10px 16px calc(10px + env(safe-area-inset-bottom));
  box-shadow:0 -6px 24px rgba(0,0,0,.10);
}
@media(min-width:750px){#it-satc{display:none!important}}
/* Reserva sitio abajo para que la barra NUNCA tape el contenido (footer, etc.) */
@media(max-width:749px){
  body{padding-bottom:calc(70px + env(safe-area-inset-bottom))}
}
/* No tapar el botón "Finalizar compra": ocultar la barra cuando el carrito (cajón) está abierto */
body:has(cart-drawer.active) #it-satc,
body:has(cart-drawer.animate.active) #it-satc,
body.it-cart-open #it-satc { display:none !important; }
[data-theme="dark"] #it-satc{
  background:#111113;
  border-top-color:rgba(255,255,255,.08);
  box-shadow:0 -6px 24px rgba(0,0,0,.4);
}
#it-satc__info{flex:1;min-width:0}
#it-satc__title{
  font-size:11.5px;font-weight:600;line-height:1.25;margin-bottom:3px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  color:var(--it-text,#111);
}
[data-theme="dark"] #it-satc__title{color:var(--it-text,#ede9e2)}
#it-satc__price{
  font-size:16px;font-weight:800;line-height:1;
  color:var(--it-accent,#d4af37);
}
#it-satc__plazo{display:block;margin-top:3px;font-size:10.5px;font-weight:600;color:#15803d}
#it-satc__plazo.is-pedido{color:#c2410c}
[data-theme="dark"] #it-satc__plazo.is-pedido{color:#fb923c}
#it-satc__btn{
  flex-shrink:0;
  height:46px;padding:0 22px;
  background:var(--color-button,#111);
  color:var(--color-button-text,#fff);
  border:none;border-radius:8px;
  font-size:13.5px;font-weight:700;letter-spacing:.025em;
  cursor:pointer;white-space:nowrap;
  transition:opacity .15s,transform .1s;
  -webkit-tap-highlight-color:transparent;
}
#it-satc__btn:active{opacity:.75;transform:scale(.97)}
#it-satc__btn[disabled]{opacity:.45;cursor:not-allowed}
</style>

<div id="it-satc" aria-label="Compra rápida">
  <div id="it-satc__info">
    <div id="it-satc__title">{{ product.title | escape }}</div>
    <div id="it-satc__price"
      data-cents="{{ satc_variant.price }}"
      data-currency="{{ shop.currency }}"
    >{{- satc_variant.price | money -}}</div>
    <span id="it-satc__plazo" class="{% if satc_pedido %}is-pedido{% endif %}">
      {%- if satc_pedido -%}Env&iacute;o en 3&ndash;5 d&iacute;as{%- else -%}En stock &middot; 24&ndash;48h{%- endif -%}
    </span>
  </div>
  <button id="it-satc__btn" type="button">Comprar ahora</button>
</div>

<script>
(function(){
  var bar   = document.getElementById('it-satc');
  var btn   = document.getElementById('it-satc__btn');
  var price = document.getElementById('it-satc__price');
  var plazo = document.getElementById('it-satc__plazo');
  var title = document.getElementById('it-satc__title');
  if(!bar || !btn) return;

  /* Mapa de stock calculado en el servidor: inventory_quantity no se expone
     al cliente, y variant.available es true para las variantes con politica
     "continue" aunque esten a cero, asi que no sirve para decidir el plazo. */
  var satcStock = {
    {%- for v in product.variants -%}
      "{{ v.id }}": {% if v.inventory_management == 'shopify' and v.inventory_quantity <= 0 %}"pedido"{% else %}"stock"{% endif %}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  };

  /* El boton real se busca EN CADA CLICK: Dawn reemplaza el formulario de
     producto al cambiar de variante, asi que guardar la referencia al cargar
     la pagina la dejaba apuntando a un nodo ya descartado (boton muerto). */
  function currentMainButton(){
    return document.getElementById('ProductSubmitButton-{{ section_id }}')
        || document.querySelector('.product-form__submit:not(#it-satc__btn)');
  }

  btn.addEventListener('click', function(){
    var target = currentMainButton();
    if(target && !target.disabled){ target.click(); }
  });

  /* Ocultar la barra cuando el carrito (cajón) está abierto, para no tapar
     el botón "Finalizar compra". */
  (function(){
    var drawer = document.querySelector('cart-drawer, #CartDrawer, .cart-drawer');
    function overlayOpen(){
      if(drawer && (drawer.classList.contains('active') || drawer.classList.contains('is-open') || drawer.hasAttribute('open'))) return true;
      /* Dawn añade overflow-hidden-* al <body> cuando se abre cualquier cajón/modal (carrito, menú, búsqueda) */
      return /overflow-hidden/.test(document.body.className || '');
    }
    /* Marca el <body> mientras la barra esta visible: el boton de WhatsApp
       usa esa clase para subirse por encima y no quedar tapado. */
    function sync(){
      var hidden = overlayOpen();
      bar.style.display = hidden ? 'none' : '';
      var on = !hidden && window.matchMedia('(max-width:749px)').matches;
      document.body.classList.toggle('it-satc-on', on);
    }
    window.addEventListener('resize', sync);
    if(window.MutationObserver){
      if(drawer){ new MutationObserver(sync).observe(drawer, {attributes:true, attributeFilter:['class','open']}); }
      new MutationObserver(sync).observe(document.body, {attributes:true, attributeFilter:['class']});
    }
    document.addEventListener('click', function(){ setTimeout(sync, 60); }, true);
    sync();
  })();

  function formatMoney(cents){
    if(window.Shopify && Shopify.formatMoney){
      return Shopify.formatMoney(cents, '{% raw %}{{amount_with_comma_separator}}{% endraw %} €');
    }
    return (cents/100).toFixed(2).replace('.', ',') + ' €';
  }

  /* Repinta la barra segun la variante seleccionada. */
  function render(v){
    if(!v) return;
    if(v.price != null){ price.textContent = formatMoney(v.price); }
    var pedido = satcStock[v.id] === 'pedido';
    if(plazo){
      plazo.classList.toggle('is-pedido', pedido);
      plazo.textContent = pedido ? 'Envío en 3–5 días' : 'En stock · 24–48h';
    }
    if(title && v.title && v.title !== 'Default Title'){
      title.textContent = {{ product.title | json }} + ' · ' + v.title;
    }
    btn.textContent = 'Comprar ahora';
    btn.disabled = false;
  }

  document.addEventListener('variant:change', function(e){
    var v = e.detail && (e.detail.variant || e.detail);
    render(v);
  });
})();
</script>
