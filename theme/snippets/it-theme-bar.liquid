{%- comment -%}
  Boton de modo claro/oscuro.

  MODO AUTOMATICO (nov 2026): la tienda se pone oscura sola al anochecer y
  vuelve a clara al amanecer, segun la hora de Espana (Europe/Madrid) y la
  puesta y salida del sol de cada mes en Andalucia. El boton sigue igual: si
  el cliente lo pulsa, se respeta su eleccion hasta el siguiente cambio de
  dia a noche (o de noche a dia); a partir de ahi vuelve el modo automatico.
  Se guarda en localStorage:
    it-theme      -> 'light' / 'dark' elegido a mano
    it-theme-key  -> tramo en el que se eligio (p. ej. 'n2026-11-27')

  Historial de la posicion, por si vuelve a dar guerra:
    - Fijo arriba a la derecha: se comia el icono del carrito.
    - Fijo abajo a la izquierda: tapaba los botones de variante.
    - Fijo abajo a la derecha sobre WhatsApp: quedaba suelto.
    - Fijo arriba midiendo el header en cada scroll: se quedaba descolgado a
      media pagina. Con position:fixed el boton vive fuera del header, asi que
      al esconderse este (Dawn oculta el header sticky al bajar) el boton se
      quedaba flotando sobre el contenido.

  Solucion definitiva: el boton deja de estar fijo y se MUEVE DENTRO del propio
  header, colocado en el hueco entre el boton de menu y el nombre de la tienda.
  Al ser hijo del header hereda su comportamiento sin una linea de JS de
  posicionamiento: sube, baja, se oculta y reaparece exactamente igual que
  "ITorostore".
{%- endcomment -%}
<style>
  #itThemeBtn{
    /* De partida fuera de la vista: el JS lo mete en el header enseguida.
       Asi no aparece un instante en la esquina antes de colocarse. */
    position:absolute;
    top:-9999px;
    left:-9999px;
    z-index:5;
    width:26px;
    height:26px;
    border-radius:50%;
    border:0.5px solid rgba(128,128,128,.22);
    background:transparent;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:13px;
    line-height:1;
    padding:0;
    opacity:.6;
    transition:opacity .18s;
    -webkit-tap-highlight-color:transparent;
  }
  #itThemeBtn:hover,
  #itThemeBtn:focus-visible{opacity:1}
  #itThemeBtn:active{transform:translateY(-50%) scale(.92)}
  /* Ya colocado dentro del header, centrado en su fila. */
  #itThemeBtn.is-placed{transform:translateY(-50%)}
</style>

<button id="itThemeBtn" type="button" aria-label="Cambiar modo claro/oscuro"><span id="itThemeIcon">☀️</span></button>

<script>
/* Tramo actual: dia o noche en Espana. Devuelve {night, key}. La noche que
   empieza un dia y sigue pasada la medianoche cuenta como la misma. */
function itTramo(){
  /* Salida y puesta del sol aproximadas en Andalucia, hora local, por mes. */
  var SOL = [[8.6,18.3],[8.2,18.9],[7.6,19.4],[8.0,20.9],[7.4,21.3],[7.1,21.6],
             [7.3,21.6],[7.7,21.2],[8.1,20.5],[8.5,19.8],[8.0,18.3],[8.4,18.1]];
  var y,m,d,h;
  try{
    var p = new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Madrid',year:'numeric',month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).formatToParts(new Date());
    var o = {}; p.forEach(function(x){ o[x.type] = x.value; });
    y = +o.year; m = +o.month; d = +o.day; h = +o.hour + (+o.minute)/60;
  }catch(e){
    var n = new Date(); y = n.getFullYear(); m = n.getMonth()+1; d = n.getDate(); h = n.getHours() + n.getMinutes()/60;
  }
  var s = SOL[m-1], amanecer = s[0], anochecer = s[1] + 0.5;
  var night = h >= anochecer || h < amanecer;
  var fecha = new Date(Date.UTC(y, m-1, d));
  if(night && h < amanecer) fecha.setUTCDate(fecha.getUTCDate()-1);
  return { night: night, key: (night ? 'n' : 'd') + fecha.toISOString().slice(0,10) };
}
function itTemaQueToca(){
  var t = itTramo(), saved = null, key = null;
  try{ saved = localStorage.getItem('it-theme'); key = localStorage.getItem('it-theme-key'); }catch(e){}
  if(saved && key === t.key) return saved;          /* eleccion del cliente en este tramo */
  return t.night ? 'dark' : 'light';                /* automatico */
}
function itAplicarTema(t){
  document.documentElement.setAttribute('data-theme', t);
  var ic = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = t === 'dark' ? '🌙' : '☀️';
}
(function(){
  itAplicarTema(itTemaQueToca());

  var btn = document.getElementById('itThemeBtn');
  if(!btn) return;

  btn.addEventListener('click', function(){ itToggleTheme(); });

  /* Si la pagina sigue abierta cuando anochece o amanece, cambia sola. */
  setInterval(function(){
    var t = itTemaQueToca();
    if(document.documentElement.getAttribute('data-theme') !== t) itAplicarTema(t);
  }, 60000);

  function visible(el){
    if(!el) return false;
    var r = el.getBoundingClientRect();
    return r.width > 0 && r.height > 0;
  }

  /* Mete el boton DENTRO del header. A partir de ahi se mueve con el. */
  function colocar(){
    var header = document.querySelector('header.header')
              || document.querySelector('.header-wrapper .header')
              || document.querySelector('.header');
    if(!header) return false;

    var cs = window.getComputedStyle(header);
    if(cs.position === 'static'){ header.style.position = 'relative'; }

    if(btn.parentNode !== header){ header.appendChild(btn); }

    /* Justo despues del boton de menu (movil). En escritorio no existe, asi
       que se pone a la izquierda del grupo de iconos de la derecha. */
    var burger = header.querySelector('.header__icon--menu, .header__icon--summary');
    if(visible(burger)){
      btn.style.left  = (burger.offsetLeft + burger.offsetWidth + 10) + 'px';
      btn.style.right = 'auto';
    } else {
      var icons = header.querySelector('.header__icons');
      if(visible(icons)){
        btn.style.left  = 'auto';
        btn.style.right = (header.offsetWidth - icons.offsetLeft + 10) + 'px';
      } else {
        btn.style.left  = '64px';
        btn.style.right = 'auto';
      }
    }
    btn.style.top = '50%';
    btn.classList.add('is-placed');
    return true;
  }

  function intentar(){
    if(colocar()) return;
    /* El header puede tardar en existir (secciones diferidas): reintento corto. */
    var n = 0;
    var t = setInterval(function(){
      if(colocar() || ++n > 20){ clearInterval(t); }
    }, 150);
  }

  if(document.readyState !== 'loading'){ intentar(); }
  else { document.addEventListener('DOMContentLoaded', intentar); }
  window.addEventListener('load', colocar);
  /* Solo al cambiar el ancho: la posicion vertical ya la lleva el header. */
  window.addEventListener('resize', colocar);
  /* Shopify vuelve a pintar secciones en el editor de temas. */
  document.addEventListener('shopify:section:load', colocar);
})();

/* Se mantienen por compatibilidad: otras partes del tema las llaman. */
function itToggleTheme(){
  var cur  = document.documentElement.getAttribute('data-theme');
  var next = cur === 'dark' ? 'light' : 'dark';
  itAplicarTema(next);
  try{ localStorage.setItem('it-theme', next); localStorage.setItem('it-theme-key', itTramo().key); }catch(e){}
}
function itUpdateThemeUI(t){
  var ic = document.getElementById('itThemeIcon');
  if(ic) ic.textContent = t === 'dark' ? '🌙' : '☀️';
}
</script>
