{%- comment -%}
  "desde 1.099€" a partir del precio más bajo del producto, para que la
  portada no se quede con precios escritos a mano cuando cambian en Shopify.
  Uso: {%- render 'it-desde', handle: 'iphone-17', fallback: 'desde 899&euro;' -%}
  Si el producto no existe o no tiene precio, se pinta el fallback.
{%- endcomment -%}
{%- assign p = all_products[handle] -%}
{%- if p != blank and p.price_min > 0 -%}
  desde {% render 'it-euros', cents: p.price_min %}&euro;
{%- else -%}
  {{- fallback -}}
{%- endif -%}
