{%- comment -%}
  FUENTE ÚNICA de los precios de compra de iPhone.

  De dónde salen:
  1. Del metaobjeto "Precio de compra iPhone" (tipo it_precio_compra).
     Fernando lo edita en Shopify > Contenido > Metaobjetos, también desde
     la app del móvil. Una entrada por modelo; cada capacidad es el máximo
     que pagamos (iPhone precintado). Capacidad vacía = no se ofrece.
  2. Si no hay ninguna entrada, de la tabla por defecto de abajo
     (misma estructura: "Modelo:orden:64,128,256,512,1TB,2TB").

  Uso:
    {% render 'it-vende-precios', modo: 'json' %}
      → [{"n":"iPhone 15 Pro","o":11,"p":[null,390,410,600,670,null]}, ...]
    {% render 'it-vende-precios', modo: 'max', modelo: 'iPhone 17 Pro Max' %}
      → 1090  (el máximo de ese modelo, vacío si no existe)

  Lo usan: sections/it-vende.liquid (tasador) y
  sections/it-compra-banner.liquid (banner de portada).
{%- endcomment -%}
{%- liquid
  assign filas = ''
  assign entradas = shop.metaobjects.it_precio_compra.values
  for e in entradas
    assign nombre = e.modelo.value | strip | replace: ':', ' ' | replace: '|', ' '
    if nombre == blank
      continue
    endif
    capture fila
      echo nombre | append: ':' | append: e.orden.value | append: ':'
      echo e.precio_64.value | append: ',' | append: e.precio_128.value | append: ',' | append: e.precio_256.value | append: ','
      echo e.precio_512.value | append: ',' | append: e.precio_1tb.value | append: ',' | append: e.precio_2tb.value
    endcapture
    assign filas = filas | append: fila | append: '|'
  endfor
  if filas == blank
    assign filas = 'iPhone 18 Pro Max:1:,,1100,1230,1270,1350|iPhone 18 Pro:2:,,970,1100,1130,|iPhone 17 Pro Max:3:,,840,970,1010,1090|iPhone 17 Pro:4:,690,730,860,890,|iPhone 17:5:,500,520,620,,|iPhone 16 Pro Max:6:,,590,810,900,|iPhone 16 Pro:7:,480,510,720,800,|iPhone 16 Plus:8:,480,530,590,,|iPhone 16:9:,410,460,550,,|iPhone 15 Pro Max:10:,,450,670,750,|iPhone 15 Pro:11:,390,410,600,670,|iPhone 15 Plus:12:,340,380,420,,|iPhone 15:13:,290,340,450,,|iPhone 14 Pro Max:14:,360,410,530,590,|iPhone 14 Pro:15:,300,340,480,530,|iPhone 14 Plus:16:,260,290,320,,|iPhone 14:17:,230,270,290,,|iPhone 13 Pro Max:18:,270,310,340,380,|iPhone 13 Pro:19:,240,270,380,420,|iPhone 13:20:,190,210,240,,|iPhone 13 mini:21:,130,150,170,,|iPhone 12 Pro Max:22:,180,200,220,,|iPhone 12 Pro:23:,150,170,190,,|iPhone 12:24:120,140,150,,,|iPhone 12 mini:25:100,110,130,,,|iPhone 11 Pro Max:26:130,,140,160,,|iPhone 11 Pro:27:110,,120,130,,|iPhone 11:28:90,100,110,,,|iPhone XS Max:29:80,,90,100,,|iPhone XS:30:60,,70,80,,|iPhone XR:31:60,70,80,,,'
  endif
  assign filas = filas | split: '|'

  if modo == 'max'
    assign maximo = 0
    for f in filas
      assign partes = f | split: ':'
      if partes[0] == modelo
        assign precios = partes[2] | split: ','
        for p in precios
          assign v = p | plus: 0
          if v > maximo
            assign maximo = v
          endif
        endfor
      endif
    endfor
    if maximo > 0
      echo maximo
    endif
  else
    echo '['
    for f in filas
      assign partes = f | split: ':'
      assign orden = partes[1] | plus: 0
      assign precios = partes[2] | append: ',,,,,,' | split: ','
      unless forloop.first
        echo ','
      endunless
      echo partes[0] | json | prepend: '{"n":'
      echo ',"o":' | append: orden | append: ',"p":['
      for i in (0..5)
        assign v = precios[i] | plus: 0
        unless forloop.first
          echo ','
        endunless
        if v > 0
          echo v
        else
          echo 'null'
        endif
      endfor
      echo ']}'
    endfor
    echo ']'
  endif
-%}
