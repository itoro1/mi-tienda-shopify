{%- comment -%}
  Seguimiento de pedido (14/10/2026).

  De donde salen los datos, para no prometer nada que no sepamos:
  - Si el cliente ha entrado con su email (cuenta de cliente de Shopify),
    se pintan SUS pedidos reales: fecha, pago, si ya ha salido del almacen,
    numero de seguimiento y enlace al estado oficial del pedido.
  - Lo que pasa despues dentro de Correos (en reparto, entregado) no se puede
    leer desde la web: Correos no deja consultar envios a otras paginas. Para
    eso esta el boton a la pagina oficial del pedido y el localizador de
    Correos con el numero ya puesto.
  - Sin sesion: formulario para entrar con el email y localizador de Correos.
  El camion se coloca en la ultima fase CONFIRMADA; nunca avanza solo.
{%- endcomment -%}
{%- assign wa = '34624150603' -%}
<section class="itsg">
  <div class="itsg__in">
    <header class="itsg__head">
      <span class="itsg__eyebrow"><span class="itsg__dot"></span>Seguimiento en tiempo real</span>
      <h1 class="itsg__title">&iquest;D&oacute;nde est&aacute; mi pedido?</h1>
      <p class="itsg__sub">Mira en qu&eacute; punto est&aacute; tu iPhone: desde que lo preparamos en nuestro almac&eacute;n hasta que llega a tu puerta.</p>
    </header>

    {%- if customer -%}
      {%- assign pedidos = customer.orders -%}
      {%- if pedidos.size == 0 -%}
        <div class="itsg__card itsg__empty">
          <p>No vemos pedidos en la cuenta <strong>{{ customer.email }}</strong>.</p>
          <p class="itsg__muted">&iquest;Compraste con otro email? <a href="{{ routes.account_logout_url }}">Cierra sesi&oacute;n</a> y entra con ese, o escr&iacute;benos por <a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">WhatsApp</a>.</p>
        </div>
      {%- endif -%}

      {%- for o in pedidos limit: 5 -%}
        {%- liquid
          assign tracking_num = ''
          assign tracking_url = ''
          assign tracking_co = ''
          assign envio_fecha = ''
          for li in o.line_items
            if li.fulfillment and tracking_num == ''
              assign tracking_num = li.fulfillment.tracking_numbers | join: ', '
              assign tracking_url = li.fulfillment.tracking_url
              assign tracking_co = li.fulfillment.tracking_company
              assign envio_fecha = li.fulfillment.created_at
            endif
          endfor

          assign fase = 1
          if o.financial_status == 'paid' or o.financial_status == 'partially_refunded'
            assign fase = 2
          endif
          if o.fulfillment_status == 'fulfilled' or o.fulfillment_status == 'partial'
            assign fase = 3
          endif
          if tracking_num != ''
            assign fase = 4
          endif
          assign cancelado = false
          if o.cancelled
            assign cancelado = true
          endif
        -%}
        <article class="itsg__card itsg__order{% if cancelado %} is-cancelled{% endif %}" data-fase="{{ fase }}">
          <div class="itsg__order-top">
            <div>
              <p class="itsg__order-n">Pedido {{ o.name }}</p>
              <p class="itsg__muted">{{ o.created_at | date: '%d/%m/%Y' }} &middot; {{ o.total_price | money }}</p>
            </div>
            <span class="itsg__badge itsg__badge--f{{ fase }}">
              {%- if cancelado -%}Cancelado
              {%- elsif fase == 4 -%}En camino con {{ tracking_co | default: 'Correos' }}
              {%- elsif fase == 3 -%}Sali&oacute; del almac&eacute;n
              {%- elsif fase == 2 -%}Preparando tu pedido
              {%- else -%}Pedido recibido{%- endif -%}
            </span>
          </div>

          <ul class="itsg__items">
            {%- for li in o.line_items limit: 3 -%}
              <li>{% if li.image %}<img src="{{ li.image | image_url: width: 96 }}" alt="" width="48" height="48" loading="lazy">{% endif %}<span>{{ li.title }}{% if li.quantity > 1 %} &times;{{ li.quantity }}{% endif %}</span></li>
            {%- endfor -%}
          </ul>

          {%- unless cancelado -%}
          <div class="itsg__track" style="--fase:{{ fase }}" role="img" aria-label="Estado del pedido: fase {{ fase }} de 5">
            <div class="itsg__road"><div class="itsg__road-fill"></div></div>
            <div class="itsg__truck" aria-hidden="true">
              <svg viewBox="0 0 64 40"><rect x="2" y="6" width="36" height="22" rx="3" class="t-body"/><path d="M38 12h12l9 9v7H38z" class="t-cab"/><rect x="42" y="14" width="8" height="6" rx="1" class="t-win"/><circle cx="14" cy="31" r="5" class="t-wheel"/><circle cx="48" cy="31" r="5" class="t-wheel"/><text x="20" y="21" text-anchor="middle" class="t-logo">ITORO</text></svg>
            </div>
            <ol class="itsg__steps">
              <li class="{% if fase >= 1 %}is-done{% endif %}"><span class="itsg__pin"></span><b>Pedido recibido</b><small>{{ o.created_at | date: '%d/%m' }}</small></li>
              <li class="{% if fase >= 2 %}is-done{% endif %}"><span class="itsg__pin"></span><b>Preparando</b><small>{% if fase >= 2 %}Pago confirmado{% else %}Pendiente de pago{% endif %}</small></li>
              <li class="{% if fase >= 3 %}is-done{% endif %}"><span class="itsg__pin"></span><b>Sali&oacute; del almac&eacute;n</b><small>{% if envio_fecha != '' %}{{ envio_fecha | date: '%d/%m' }}{% else %}&mdash;{% endif %}</small></li>
              <li class="{% if fase >= 4 %}is-done{% endif %}"><span class="itsg__pin"></span><b>En camino</b><small>{% if tracking_num != '' %}{{ tracking_co | default: 'Correos' }}{% else %}&mdash;{% endif %}</small></li>
              <li><span class="itsg__pin"></span><b>Entregado</b><small>Ver en Correos</small></li>
            </ol>
          </div>
          {%- endunless -%}

          <div class="itsg__actions">
            {%- if tracking_num != '' -%}
              <p class="itsg__code">N&ordm; de seguimiento: <strong>{{ tracking_num }}</strong> <button type="button" class="itsg__copy" data-copy="{{ tracking_num | escape }}">Copiar</button></p>
              <a class="itsg__btn itsg__btn--dark" href="{{ tracking_url | default: 'https://www.correos.es/es/es/herramientas/localizador/envios' }}" target="_blank" rel="noopener">Ver d&oacute;nde est&aacute; en {{ tracking_co | default: 'Correos' }} &rarr;</a>
            {%- endif -%}
            <a class="itsg__btn" href="{{ o.order_status_url }}" target="_blank" rel="noopener">Estado oficial del pedido</a>
            <a class="itsg__btn itsg__btn--wa" href="https://wa.me/{{ wa }}?text={{ 'Hola, quería saber cómo va mi pedido ' | append: o.name | url_encode }}" target="_blank" rel="noopener">Preguntar por WhatsApp</a>
          </div>
        </article>
      {%- endfor -%}

      <p class="itsg__muted itsg__center">Has entrado como {{ customer.email }} &middot; <a href="{{ routes.account_logout_url }}">Salir</a></p>

    {%- else -%}
      <div class="itsg__grid">
        <div class="itsg__card">
          <div class="itsg__demo" aria-hidden="true">
            <div class="itsg__road"><div class="itsg__road-fill itsg__road-fill--loop"></div></div>
            <div class="itsg__truck itsg__truck--loop"><svg viewBox="0 0 64 40"><rect x="2" y="6" width="36" height="22" rx="3" class="t-body"/><path d="M38 12h12l9 9v7H38z" class="t-cab"/><rect x="42" y="14" width="8" height="6" rx="1" class="t-win"/><circle cx="14" cy="31" r="5" class="t-wheel"/><circle cx="48" cy="31" r="5" class="t-wheel"/><text x="20" y="21" text-anchor="middle" class="t-logo">ITORO</text></svg></div>
          </div>
          <h2 class="itsg__h2">Ver mi pedido</h2>
          <p class="itsg__muted">Entra con el email con el que compraste. Te mandamos un c&oacute;digo y ver&aacute;s aqu&iacute; tu pedido: si lo estamos preparando, si ya sali&oacute; de nuestro almac&eacute;n y su n&uacute;mero de seguimiento.</p>
          <a class="itsg__btn itsg__btn--dark itsg__btn--full" href="{{ routes.account_login_url }}">Entrar con mi email &rarr;</a>
        </div>

        <div class="itsg__card">
          <h2 class="itsg__h2">Tengo el n&uacute;mero de Correos</h2>
          <p class="itsg__muted">Te lo enviamos por email y WhatsApp en cuanto el pedido sale del almac&eacute;n.</p>
          <form id="itsgForm" class="itsg__form" novalidate>
            <label for="itsgCode" class="itsg__sr">N&uacute;mero de seguimiento</label>
            <input id="itsgCode" type="text" inputmode="text" autocomplete="off" placeholder="Ej.: PQ4F6P0703357350108001A">
            <button type="submit" class="itsg__btn itsg__btn--dark">Rastrear</button>
          </form>
          <p id="itsgErr" class="itsg__err" hidden>Escribe tu n&uacute;mero de seguimiento.</p>
          <p class="itsg__muted itsg__small">Se abre el localizador oficial de Correos con tu n&uacute;mero ya puesto.</p>
        </div>
      </div>
    {%- endif -%}

    <div class="itsg__help">
      <div><b>Env&iacute;o gratis con Correos</b><span>24&ndash;48 h si est&aacute; en stock &middot; 3&ndash;5 d&iacute;as h&aacute;biles si no</span></div>
      <div><b>&iquest;Dudas con tu env&iacute;o?</b><span><a href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">WhatsApp 624 15 06 03</a> &middot; te respondemos al momento</span></div>
    </div>
  </div>
</section>

<style>
.itsg{background:var(--it-bg,#faf9f6);padding:48px 16px 64px}
.itsg__in{max-width:860px;margin:0 auto}
.itsg__head{text-align:center;margin-bottom:28px}
.itsg__eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:10.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:#15803d;background:rgba(21,128,61,.09);border:.5px solid rgba(21,128,61,.22);padding:5px 12px;border-radius:20px}
.itsg__dot{width:7px;height:7px;border-radius:50%;background:#22c55e;animation:itsgPulse 1.8s infinite}
@keyframes itsgPulse{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.45)}50%{box-shadow:0 0 0 5px rgba(34,197,94,0)}}
.itsg__title{font-size:clamp(26px,4vw,38px);font-weight:700;letter-spacing:-.02em;color:var(--it-text,#0a0a0a);margin:14px 0 8px}
.itsg__sub{font-size:14.5px;color:var(--it-muted,#636360);line-height:1.6;max-width:560px;margin:0 auto}
.itsg__grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.itsg__card{background:var(--it-surface,#fff);border:.5px solid var(--it-border,rgba(0,0,0,.09));border-radius:18px;padding:22px;margin-bottom:16px;box-shadow:0 6px 24px rgba(0,0,0,.04)}
.itsg__h2{font-size:18px;font-weight:700;margin:0 0 6px;color:var(--it-text,#111)}
.itsg__muted{font-size:13px;color:var(--it-muted,#636360);line-height:1.6;margin:0 0 14px}
.itsg__small{font-size:11.5px;margin:10px 0 0}
.itsg__center{text-align:center}
.itsg__muted a,.itsg__help a{color:inherit;text-decoration:underline}
.itsg__order-top{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;flex-wrap:wrap}
.itsg__order-n{font-size:17px;font-weight:700;margin:0 0 2px;color:var(--it-text,#111)}
.itsg__badge{font-size:11.5px;font-weight:700;padding:6px 12px;border-radius:20px;background:rgba(212,175,55,.12);color:#8a6d0b;border:.5px solid rgba(212,175,55,.35);white-space:nowrap}
.itsg__badge--f3,.itsg__badge--f4{background:rgba(21,128,61,.1);color:#15803d;border-color:rgba(21,128,61,.3)}
.is-cancelled .itsg__badge{background:rgba(220,38,38,.08);color:#b91c1c;border-color:rgba(220,38,38,.25)}
.itsg__items{list-style:none;margin:14px 0 4px;padding:0;display:flex;flex-wrap:wrap;gap:8px}
.itsg__items li{display:flex;align-items:center;gap:8px;font-size:12.5px;background:var(--it-surface2,#f2f0ec);border-radius:10px;padding:5px 10px 5px 5px}
.itsg__items img{width:34px;height:34px;object-fit:contain;border-radius:7px;background:#fff}
/* Recorrido */
.itsg__track{position:relative;margin:26px 4px 6px;--pos:calc((var(--fase) - 1) / 4)}
.itsg__road{position:relative;height:6px;border-radius:6px;background:repeating-linear-gradient(90deg,var(--it-border,#e5e2db) 0 14px,transparent 14px 22px);margin:0 4%}
.itsg__road-fill{position:absolute;left:0;top:0;bottom:0;width:calc(var(--pos) * 100%);border-radius:6px;background:linear-gradient(90deg,#d4af37,#15803d);transition:width 1.4s cubic-bezier(.4,0,.2,1)}
.itsg__truck{position:absolute;top:-34px;left:calc(4% + var(--pos) * 92%);width:58px;transform:translateX(-50%);transition:left 1.4s cubic-bezier(.4,0,.2,1);animation:itsgBump .5s ease-in-out infinite alternate}
.itsg__track[style*="--fase:5"] .itsg__truck{animation:none}
@keyframes itsgBump{from{transform:translateX(-50%) translateY(0)}to{transform:translateX(-50%) translateY(-2px)}}
.itsg__truck svg{width:100%;height:auto;display:block;filter:drop-shadow(0 4px 6px rgba(0,0,0,.15))}
.t-body{fill:#0f172a}.t-cab{fill:#d4af37}.t-win{fill:#e0f2fe}.t-wheel{fill:#1f2937;stroke:#9ca3af;stroke-width:2}.t-logo{fill:#d4af37;font:700 7px/1 system-ui,sans-serif;letter-spacing:.5px}
.itsg__steps{list-style:none;display:grid;grid-template-columns:repeat(5,1fr);gap:4px;margin:14px 0 0;padding:0;text-align:center}
.itsg__steps li{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:11.5px;color:var(--it-muted,#8a8a86)}
.itsg__steps b{font-weight:600;line-height:1.25}
.itsg__steps small{font-size:10.5px;opacity:.8}
.itsg__pin{width:14px;height:14px;border-radius:50%;background:var(--it-surface,#fff);border:2px solid var(--it-border2,#d6d3cc);margin-top:-24px;margin-bottom:6px}
.itsg__steps li.is-done{color:var(--it-text,#111)}
.itsg__steps li.is-done .itsg__pin{background:#15803d;border-color:#15803d;box-shadow:0 0 0 4px rgba(21,128,61,.15)}
.itsg__actions{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:18px}
.itsg__code{width:100%;font-size:13px;margin:0 0 4px;color:var(--it-text,#111)}
.itsg__copy{font:inherit;font-size:11.5px;border:.5px solid var(--it-border2,#ccc);background:transparent;border-radius:6px;padding:2px 8px;cursor:pointer;margin-left:6px}
.itsg__btn{display:inline-flex;align-items:center;justify-content:center;height:42px;padding:0 16px;border-radius:10px;border:1.5px solid var(--it-border2,rgba(0,0,0,.18));font-size:13px;font-weight:700;text-decoration:none;color:var(--it-text,#111);background:transparent;cursor:pointer;font-family:inherit}
.itsg__btn--dark{background:var(--it-text,#0a0a0a);border-color:var(--it-text,#0a0a0a);color:#fff}
.itsg__btn--dark:hover{opacity:.88;color:#fff}
.itsg__btn--wa{border-color:#25d366;color:#128c4a}
.itsg__btn--full{width:100%}
.itsg__form{display:flex;gap:8px}
.itsg__form input{flex:1;min-width:0;height:44px;border-radius:10px;border:1px solid var(--it-border2,#d6d3cc);padding:0 12px;font-size:14px;background:var(--it-bg,#fff);color:var(--it-text,#111)}
.itsg__err{color:#b91c1c;font-size:12px;margin:8px 0 0}
.itsg__sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.itsg__demo{position:relative;height:56px;margin:4px 0 14px;padding-top:34px}
.itsg__road-fill--loop{width:100%;opacity:.35}
.itsg__truck--loop{left:4%;animation:itsgDrive 6s linear infinite}
@keyframes itsgDrive{0%{left:4%}100%{left:96%}}
.itsg__help{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:8px}
.itsg__help div{display:flex;flex-direction:column;gap:3px;font-size:12.5px;color:var(--it-muted,#636360);background:var(--it-surface,#fff);border:.5px solid var(--it-border,rgba(0,0,0,.09));border-radius:14px;padding:14px 16px}
.itsg__help b{color:var(--it-text,#111);font-size:13.5px}
[data-theme="dark"] .itsg__btn--dark{background:#ede9e2;border-color:#ede9e2;color:#0a0a0a}
@media(max-width:700px){
  .itsg__grid,.itsg__help{grid-template-columns:1fr}
  .itsg__steps li{font-size:10px}
  .itsg__steps small{display:none}
  .itsg__truck{width:46px;top:-28px}
}
@media(prefers-reduced-motion:reduce){.itsg__truck,.itsg__dot{animation:none}.itsg__road-fill,.itsg__truck{transition:none}}
</style>

<script>
(function(){
  var f=document.getElementById('itsgForm');
  if(f){
    f.addEventListener('submit',function(e){
      e.preventDefault();
      var i=document.getElementById('itsgCode'),err=document.getElementById('itsgErr');
      var c=(i.value||'').trim().replace(/\s+/g,'').toUpperCase();
      if(!c){ if(err) err.hidden=false; i.focus(); return; }
      if(err) err.hidden=true;
      window.open('https://www.correos.es/es/es/herramientas/localizador/envios?tracking-number='+encodeURIComponent(c),'_blank','noopener');
    });
  }
  document.querySelectorAll('.itsg__copy').forEach(function(b){
    b.addEventListener('click',function(){
      var t=b.getAttribute('data-copy');
      if(navigator.clipboard){ navigator.clipboard.writeText(t).then(function(){ b.textContent='Copiado'; setTimeout(function(){ b.textContent='Copiar'; },1500); }); }
    });
  });
  /* El camion arranca desde el almacen y se desplaza hasta su fase real. */
  document.querySelectorAll('.itsg__track').forEach(function(t){
    var real=t.style.getPropertyValue('--fase');
    t.style.setProperty('--fase','1');
    requestAnimationFrame(function(){ requestAnimationFrame(function(){ t.style.setProperty('--fase',real); }); });
  });
})();
</script>

{% schema %}
{"name":"Seguimiento de pedido","settings":[],"presets":[{"name":"Seguimiento de pedido"}]}
{% endschema %}
