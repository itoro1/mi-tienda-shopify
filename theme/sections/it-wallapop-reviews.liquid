{%- if section.settings.show_section -%}
{{ 'it-reviews-carousel.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  include y no render: render aisla el ambito y las variables wp_* del
  snippet no llegarian hasta aqui.
{%- endcomment -%}
{% include 'it-wallapop-data' %}
{%- assign sid = section.id -%}
<section class="it-section it-rev">
  {%- if section.settings.eyebrow != blank -%}
    <p class="it-eyebrow">{{ section.settings.eyebrow }}</p>
  {%- endif -%}
  <h2 class="it-section-title">{{ section.settings.title }}</h2>
  <div class="it-rev__badge">
    <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#13c1ac"/></svg>
    <span class="it-rev__score">&#9733;&#9733;&#9733;&#9733;&#9733; {{ wp_avg }} sobre 5 &mdash; {{ wp_reviews }} valoraciones verificadas en Wallapop</span>
  </div>

  <div class="it-rev__vp" data-it-rev>
    <button class="it-rev__nav it-rev__nav--prev" type="button" data-it-prev aria-label="Valoraciones anteriores" aria-controls="itrev-{{ sid }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>

    <div class="it-rev__track" id="itrev-{{ sid }}" tabindex="0" role="group" aria-roledescription="carrusel" aria-label="Valoraciones de clientes en Wallapop" data-it-track>
      {%- for t in wp_text -%}
        {%- assign i = forloop.index0 -%}
        {%- assign nm = wp_name[i] -%}
        {%- assign st = wp_stars[i] | plus: 0 -%}
        {%- assign ph = wp_photo[i] -%}
        {%- assign pr = wp_prod[i] -%}
        <article class="it-rev__card" aria-roledescription="valoracion" aria-label="{{ forloop.index }} de {{ wp_total }}">
          <div class="it-rev__top">
            <div class="it-rev__stars" role="img" aria-label="{{ st }} de 5 estrellas">
              {%- for s in (1..5) -%}
                {%- if s <= st -%}{%- assign fill = '#13c1ac' -%}{%- else -%}{%- assign fill = '#d6d6d6' -%}{%- endif -%}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="{{ fill }}" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              {%- endfor -%}
            </div>
            {%- if pr != blank -%}
              <img class="it-rev__thumb" src="{{ pr }}" alt="Producto comprado por {{ nm | escape }}" width="56" height="56" loading="lazy" decoding="async">
            {%- endif -%}
          </div>
          <p class="it-rev__text">&ldquo;{{ t }}&rdquo;</p>
          <div class="it-rev__foot">
            <div class="it-rev__who">
              {%- if ph != blank -%}
                <img class="it-rev__av" src="{{ ph }}" alt="" width="34" height="34" loading="lazy" decoding="async">
              {%- else -%}
                <span class="it-rev__avph" aria-hidden="true">{{ nm | slice: 0 | upcase }}</span>
              {%- endif -%}
              <span>
                <span class="it-rev__name">{{ nm }}</span><br>
                <span class="it-rev__when">{{ wp_when[i] }}</span>
              </span>
            </div>
            <span class="it-rev__src">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="#13c1ac" aria-hidden="true"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
              Wallapop
            </span>
          </div>
        </article>
      {%- endfor -%}
    </div>

    <button class="it-rev__nav it-rev__nav--next" type="button" data-it-next aria-label="Valoraciones siguientes" aria-controls="itrev-{{ sid }}">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="it-rev__dots" data-it-dots></div>
  </div>

  {%- if wp_profile != blank -%}
    <div class="it-rev__cta">
      <a href="{{ wp_profile }}" target="_blank" rel="noopener" class="it-btn-secondary">Ver las {{ wp_reviews }} valoraciones en Wallapop &rarr;</a>
    </div>
  {%- endif -%}
</section>
{{ 'it-reviews-carousel.js' | asset_url | script_tag }}
{%- endif -%}

{% schema %}
{
  "name": "Valoraciones Wallapop",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Mostrar seccion", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno arriba", "default": "Compradores reales" },
    { "type": "text", "id": "title", "label": "Titulo", "default": "Lo que dicen nuestros clientes" },
    { "type": "paragraph", "content": "Las valoraciones, la nota media y el enlace se leen de snippets/it-wallapop-data.liquid, extraidos del perfil real de Wallapop." }
  ],
  "presets": [{ "name": "Valoraciones Wallapop" }]
}
{% endschema %}
