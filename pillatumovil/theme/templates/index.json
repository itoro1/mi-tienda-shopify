        },
        "q2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué cargador necesita mi iPhone?",
            "respuesta": "<p>El adaptador de 20 W sirve para cualquier iPhone. Lo que cambia es el cable: del iPhone 15 en adelante, USB-C a USB-C; del iPhone 8 al 14, USB-C a Lightning.</p>"
          }
        },
        "q3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Carga rápido?",
            "respuesta": "<p>Sí. Con el adaptador de 20 W, el iPhone 8 o posterior admite carga rápida: según Apple, hasta el 50 % en unos 30 minutos.</p>"
