{%- comment -%}
  Anadidos del carrito lateral (snippets/cart-drawer.liquid):
    {%- render 'ps-carrito-extra', zona: 'aviso' -%}       bajo el titulo
    {%- render 'ps-carrito-extra', zona: 'sugerencia' -%}  bajo los productos
    {%- render 'ps-carrito-extra', zona: 'pie' -%}         bajo "Pagar pedido"

  Sugerencia, segun las referencias (SKU) del carrito:
  - Cargador (CHRG-) sin cable ni pack: los dos cables, para que elija el de
    su iPhone.
  - Cable (CBL-) sin cargador ni pack: el cargador de 20 W.
  - Si ya hay un pack o estan las dos cosas, nada.
  Los botones son formularios data-ps-anadir (assets/ps-carrito.js): anaden
  sin salir y el carrito se vuelve a pintar entero, sugerencia incluida.
{%- endcomment -%}
{%- case zona -%}
  {%- when 'aviso' -%}
    {%- unless cart == empty -%}
      <p class="ps-ca">{% render 'ps-icono', nombre: 'envio', tam: 20 %}<span><b>Envío gratis.</b> Lo recibe en casa en 24&#8288;-&#8288;48&nbsp;h.</span></p>
    {%- endunless -%}

  {%- when 'sugerencia' -%}
    {%- liquid
      assign hay_cargador = false
      assign hay_cable = false
      assign hay_pack = false
      for item in cart.items
        if item.sku contains 'CHRG-'
          assign hay_cargador = true
        elsif item.sku contains 'CBL-'
          assign hay_cable = true
        elsif item.sku contains 'PACK-'
          assign hay_pack = true
        endif
      endfor
      assign sug = ''
      if hay_pack == false
        if hay_cargador and hay_cable == false
          assign sug = 'cable-usb-c-a-usb-c-1m-apple,cable-usb-c-a-lightning-1m-apple'
          assign titulo = '¿Y el cable? Elija el de su iPhone'
        elsif hay_cable and hay_cargador == false
          assign sug = 'cargador-usb-c-20w-apple-original'
          assign titulo = '¿Le falta el cargador?'
        endif
      endif
    -%}
    {%- if sug != '' -%}
      <div class="ps-cs">
        <p class="ps-cs__tit">{{ titulo }}</p>
        <ul class="ps-cs__lista" role="list">
          {%- assign handles = sug | split: ',' -%}
          {%- for h in handles -%}
            {%- assign p = all_products[h] -%}
            {%- if p == blank or p.available == false -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              capture pa
                render 'ps-pvp-centimos', product: p
              endcapture
              assign pa = pa | strip | plus: 0
              case h
                when 'cable-usb-c-a-usb-c-1m-apple'
                  assign nombre = 'Cable USB-C (1 m)'
                  assign nota = 'iPhone 15 o posterior'
                when 'cable-usb-c-a-lightning-1m-apple'
                  assign nombre = 'Cable USB-C a Lightning (1 m)'
                  assign nota = 'iPhone 8 al 14'
                else
                  assign nombre = 'Cargador USB-C de 20 W'
                  assign nota = 'Carga rápida, para cualquier iPhone'
              endcase
            -%}
            <li class="ps-cs__item">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 160 | image_tag: class: 'ps-cs__img', loading: 'lazy', alt: '' }}
              {%- endif -%}
              <div class="ps-cs__info">
                <a class="ps-cs__nombre" href="{{ p.url }}">{{ nombre }}</a>
                <span class="ps-cs__nota">{{ nota }}</span>
                <span class="ps-cs__precio">{{ v.price | money_without_currency }}&nbsp;€{% if pa > v.price %} <small>En Apple <s>{{ pa | money_without_currency }}&nbsp;€</s></small>{% endif %}</span>
              </div>
              <form method="post" action="{{ routes.cart_add_url }}" data-ps-anadir>
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                <button class="ps-cs__btn" type="submit" aria-label="Añadir {{ nombre }}">Añadir</button>
              </form>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  {%- when 'pie' -%}
    <ul class="ps-cp" role="list">
      <li>{% render 'ps-icono', nombre: 'garantia', tam: 16 %}Originales de Apple, 3 años de garantía</li>
      <li>{% render 'ps-icono', nombre: 'devolucion', tam: 16 %}14 días para devolverlo gratis</li>
    </ul>
{%- endcase -%}

{% stylesheet %}
.ps-ca{display:flex;align-items:center;gap:10px;margin:0 0 14px;padding:11px 14px;border-radius:12px;background:#141824;color:#f4f1ea;font-size:14px;line-height:1.35}
.ps-ca svg{flex:none;color:#e2cc9a}
.ps-ca b{color:#e2cc9a}
.ps-cs{margin:18px 0 8px;padding:16px;border-radius:16px;background:#f3f1ec;color:#141824}
.ps-cs__tit{margin:0 0 6px;font-size:15px;font-weight:700}
.ps-cs__lista{list-style:none;margin:0;padding:0}
.ps-cs__item{display:flex;align-items:center;gap:12px;padding:10px 0}
.ps-cs__item + .ps-cs__item{border-top:1px solid rgba(20,24,36,.1)}
.ps-cs__img{flex:none;width:56px;height:56px;border-radius:10px;object-fit:contain;background:#fff}
.ps-cs__info{display:flex;flex-direction:column;gap:1px;min-width:0;flex:1;line-height:1.35}
.ps-cs__nombre{font-size:14px;font-weight:700;color:inherit;text-decoration:none}
.ps-cs__nombre:hover{text-decoration:underline;text-underline-offset:3px}
.ps-cs__nota{font-size:13px;color:#585d6b}
.ps-cs__precio{font-size:14px;font-weight:700;font-variant-numeric:tabular-nums}
.ps-cs__precio small{font-size:12px;font-weight:400;color:#585d6b}
.ps-cs form{flex:none;margin:0}
.ps-cs__btn{min-height:40px;padding:0 16px;border:0;border-radius:999px;background:#141824;color:#f4f1ea;font-family:inherit;font-size:14px;font-weight:700;cursor:pointer}
.ps-cs__btn:hover{background:#262c3d}
.ps-cs__btn[disabled]{opacity:.5}
.ps-cs__btn:focus-visible{outline:2px solid #7d5f28;outline-offset:3px}
.ps-cs .ps-tar__error{flex-basis:100%;margin:6px 0 0}
.ps-cp{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 16px;list-style:none;margin:12px 0 0;padding:0;font-size:13px;color:#585d6b}
.ps-cp li{display:flex;align-items:center;gap:6px}
.ps-cp svg{flex:none;color:#7d5f28}
{% endstylesheet %}
