{%- comment -%}
  Anadidos del carrito lateral (snippets/cart-drawer.liquid):
    {%- render 'ps-carrito-extra', zona: 'aviso' -%}       bajo el titulo
    {%- render 'ps-carrito-extra', zona: 'sugerencia' -%}  bajo los productos
    {%- render 'ps-carrito-extra', zona: 'pie' -%}         bajo "Pagar pedido"

  Sugerencia, segun las referencias (SKU) del carrito:
  - Cargador (CHRG-) sin cable ni pack: los dos cables, para que elija el de
    su iPhone.
  - Cable (CBL-) sin cargador ni pack: el cargador de 20 W.
  - Si ya hay un pack o estan las dos cosas, nada.
  Los botones son formularios data-ps-anadir (assets/ps-carrito.js): anaden
  sin salir y el carrito se vuelve a pintar entero, sugerencia incluida.
{%- endcomment -%}
{%- case zona -%}
  {%- when 'aviso' -%}
    {%- unless cart == empty -%}
      <p class="ps-ca">{% render 'ps-icono', nombre: 'envio', tam: 20 %}<span><b>Envío gratis.</b> Lo recibe en casa en 24&#8288;-&#8288;48&nbsp;h.</span></p>
    {%- endunless -%}

  {%- when 'sugerencia' -%}
    {%- liquid
      assign hay_cargador = false
      assign hay_cable = false
      assign hay_pack = false
      for item in cart.items
        if item.sku contains 'CHRG-'
          assign hay_cargador = true
        elsif item.sku contains 'CBL-'
          assign hay_cable = true
        elsif item.sku contains 'PACK-'
          assign hay_pack = true
        endif
      endfor
      assign sug = ''
      if hay_pack == false
        if hay_cargador and hay_cable == false
          assign sug = 'cable-usb-c-a-usb-c-1m-apple,cable-usb-c-a-lightning-1m-apple'
          assign titulo = '¿Y el cable? Elija el de su iPhone'
        elsif hay_cable and hay_cargador == false
          assign sug = 'cargador-usb-c-20w-apple-original'
          assign titulo = '¿Le falta el cargador?'
        endif
      endif
    -%}
    {%- if sug != '' -%}
      <div class="ps-cs">
        <p class="ps-cs__tit">{{ titulo }}</p>
        <ul class="ps-cs__lista" role="list">
          {%- assign handles = sug | split: ',' -%}
          {%- for h in handles -%}
            {%- assign p = all_products[h] -%}
            {%- if p == blank or p.available == false -%}{%- continue -%}{%- endif -%}
            {%- liquid
              assign v = p.selected_or_first_available_variant
              capture nombre
                render 'ps-dato', p: p, campo: 'nombre'
              endcapture
              capture nota
                render 'ps-dato', p: p, campo: 'para'
              endcapture
            -%}
            <li class="ps-cs__item">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 160 | image_tag: class: 'ps-cs__img', loading: 'lazy', alt: '' }}
              {%- endif -%}
              <div class="ps-cs__info">
                <a class="ps-cs__nombre" href="{{ p.url }}">{{ nombre | strip }}</a>
                <span class="ps-cs__nota">{{ nota | strip }}</span>
                <span class="ps-cs__precio">{{ v.price | money_without_currency }}&nbsp;€</span>
              </div>
              <form method="post" action="{{ routes.cart_add_url }}" data-ps-anadir>
                <input type="hidden" name="id" value="{{ v.id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
                <button class="ps-cs__btn" type="submit" aria-label="Añadir {{ nombre | strip | escape }}">Añadir</button>
              </form>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  {%- when 'pie' -%}
    <ul class="ps-cp" role="list">
      <li>{% render 'ps-icono', nombre: 'garantia', tam: 16 %}Original de Apple, 3&nbsp;años de garantía</li>
      <li>{% render 'ps-icono', nombre: 'devolucion', tam: 16 %}14&nbsp;días para devolverlo, gratis</li>
    </ul>
{%- endcase -%}

{% stylesheet %}
/* Rediseño 2026 · carrito lateral (snippets/cart-drawer.liquid) y página del
   carrito: letra de texto, sin mayúsculas espaciadas ni filetes, total en
   Unbounded, botón de pago en oro y a todo el ancho. */
.ps-ca{display:flex;align-items:center;gap:10px;margin:0 0 16px;padding:12px 14px;background:#0b0f1a;color:#f4f1ea;font-size:15px;line-height:1.35}
.ps-ca svg{flex:none;color:#d9bb7c}
.ps-ca b{color:#d9bb7c}
.ps-cs{margin:20px 0 8px;padding:16px;background:#e8e5df;color:#141824}
.ps-cs__tit{margin:0 0 6px;font-size:16px;font-weight:700}
.ps-cs__lista{list-style:none;margin:0;padding:0}
.ps-cs__item{display:flex;align-items:center;gap:12px;padding:10px 0}
.ps-cs__img{flex:none;width:56px;height:56px;object-fit:contain;background:#f3f1ec;mix-blend-mode:multiply}
.ps-cs__info{display:flex;flex-direction:column;gap:1px;min-width:0;flex:1;line-height:1.35}
.ps-cs__nombre{font-size:15px;font-weight:700;color:inherit;text-decoration:none;overflow-wrap:anywhere}
.ps-cs__nota{font-size:14px;color:#474c59}
.ps-cs__precio{font-size:15px;font-weight:700;font-variant-numeric:tabular-nums}
.ps-cs form{flex:none;margin:0}
.ps-cs__btn{min-height:44px;padding:0 18px;border:0;border-radius:999px;background:#141824;color:#f4f1ea;font-family:inherit;font-size:15px;font-weight:700;cursor:pointer;transition:transform 120ms cubic-bezier(.23,1,.32,1)}
.ps-cs__btn:active{transform:scale(.96)}
.ps-cs__btn[disabled]{opacity:.5}
.ps-cs__btn:focus-visible{outline:2px solid #7d5f28;outline-offset:3px}
.ps-cs .ps-tar__error{flex-basis:100%;margin:6px 0 0}
.ps-cp{display:flex;flex-wrap:wrap;justify-content:center;gap:4px 16px;list-style:none;margin:12px 0 0;padding:0;font-size:14px;color:#474c59}
.ps-cp li{display:flex;align-items:center;gap:6px}
.ps-cp svg{flex:none;color:#7d5f28}

/* Cajón y página del carrito de Dawn */
cart-drawer .drawer__heading,.cart__items ~ * h1,.title-wrapper-with-link .title{font-family:var(--font-heading-family);font-weight:600;letter-spacing:-.025em}
cart-drawer .drawer__inner{border:0}
cart-drawer .cart-items thead th,.cart-items thead th{font-size:0;line-height:0;padding:0;border:0}
cart-drawer .cart-items thead,.cart-items thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.cart-item .cart-item__name.h4,.cart-item .cart-item__name{font-family:var(--font-body-family);font-size:16px;font-weight:700;letter-spacing:0;line-height:1.3;text-decoration:none}
.cart-item__name:hover{text-decoration:underline;text-decoration-color:#c9a86a;text-underline-offset:4px}
.cart-item .product-option{font-size:14px;color:#474c59}
.cart-item__image{mix-blend-mode:multiply}
.cart-item__image{background:#e8e5df}
cart-drawer .cart-item{border:0}
.cart-items td,.cart-items th{border:0}
.cart-drawer .cart-items,.cart-drawer tbody{display:block}
.quantity{border-radius:999px}
.quantity:after,.quantity:before{border-radius:999px}
.totals__total{font-family:var(--font-body-family);font-size:17px;font-weight:700;letter-spacing:0}
.totals__total-value{font-family:var(--font-heading-family);font-size:28px;font-weight:600;letter-spacing:-.03em}
.tax-note{font-size:14px;color:#474c59}
.cart__ctas .cart__checkout-button,.cart__checkout-button{width:100%;min-height:56px;font-size:17px;font-weight:700;letter-spacing:0;transition:transform 120ms cubic-bezier(.23,1,.32,1)}
.cart__checkout-button:active{transform:scale(.98)}
.cart-drawer__footer{border-top:0}
.drawer__footer{border-top:0}
{% endstylesheet %}
