{%- comment -%}
  Rediseño 2026 · tarjeta de producto (colecciones, buscar, «Quizá también
  necesite», 404). Uso: {% render 'ps-tarjeta', p: producto %}
  Opcional: motivo: 'Para el coche o la oficina' (una línea encima del nombre
  que explica por qué se sugiere).

  - Foto real sobre blanco, fundida con la tesela; al pasar el ratón (solo
    con ratón), la segunda foto si la hay.
  - Nombre corto y para qué iPhone (ajuste global «Nombres cortos»): sirve
    igual para móviles cuando los haya.
  - Precio, «En Apple» con su fecha (nunca un «antes» inventado).
  - Una variante: «Añadir al carrito» sin salir de la página
    (assets/ps-carrito.js; sin JavaScript va al carrito). Varias (packs):
    «Elegir cantidad», a la ficha.
  - Con selector: true (página de colección), los packs enseñan «1 pack,
    2 packs, 3 packs» con su precio y se añaden desde la tarjeta. Lo pidió
    el dueño el 12/11/2026 para que quien llega del anuncio elija sin
    cambiar de página.
  - Agotado: lo dice y no deja añadir.
  - data-tipo (pack, cargador, cable, movil, otro) y data-conector (usbc,
    lightning, todos) salen de la referencia: los usan los filtros de la
    colección.
{%- endcomment -%}
{%- liquid
  assign v = p.selected_or_first_available_variant
  assign segunda = p.images[1]
  capture nombre
    render 'ps-dato', p: p, campo: 'nombre'
  endcapture
  capture para
    render 'ps-dato', p: p, campo: 'para'
  endcapture
  assign sku = p.variants.first.sku | upcase
  assign tipo = 'otro'
  if sku contains 'PACK-'
    assign tipo = 'pack'
  elsif sku contains 'CHRG-'
    assign tipo = 'cargador'
  elsif sku contains 'CBL-'
    assign tipo = 'cable'
  elsif sku contains 'IPH-'
    assign tipo = 'movil'
  else
    assign ptipo = p.type | downcase
    if ptipo contains 'móvil' or ptipo contains 'movil' or ptipo contains 'iphone' or ptipo contains 'smartphone'
      assign tipo = 'movil'
    endif
  endif
  assign estado = ''
  if tipo == 'movil'
    if p.tags contains 'nuevo'
      assign estado = 'nuevo'
      assign para = 'Nuevo y precintado'
    else
      assign estado = 'segunda-mano'
      assign para = 'De segunda mano, revisado'
    endif
  endif
  assign conector = ''
  if tipo == 'cargador'
    assign conector = 'todos'
  elsif tipo == 'pack' or tipo == 'cable'
    if sku contains 'LTN'
      assign conector = 'lightning'
    else
      assign conector = 'usbc'
    endif
  endif
-%}
<li class="ps-tar ps-tar--{{ tipo }}" data-tipo="{{ tipo }}" data-conector="{{ conector }}" data-estado="{{ estado }}">
  <a class="ps-tar__foto{% if segunda %} ps-tar__foto--doble{% endif %}" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
    {%- if p.featured_image -%}
      {{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 990px) 22vw, (min-width: 600px) 45vw, 50vw', alt: '', class: 'ps-tar__img' }}
    {%- endif -%}
    {%- if segunda -%}
      {{ segunda | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300,500,800', sizes: '(min-width: 990px) 22vw, (min-width: 600px) 45vw, 50vw', alt: '', class: 'ps-tar__img ps-tar__img--2' }}
    {%- endif -%}
  </a>
  <div class="ps-tar__txt">
    {%- if motivo != blank -%}<p class="ps-tar__motivo">{{ motivo }}</p>{%- endif -%}
    <h3 class="ps-tar__nombre"><a href="{{ p.url }}">{{ nombre | strip }}</a></h3>
    {%- if para != blank -%}<p class="ps-tar__para">{{ para | strip }}</p>{%- endif -%}
    {%- if tipo == 'movil' and p.price_varies -%}
      <p class="ps-tar__desde"><span>Desde</span> <span class="ps-cmp__aqui ps-num">{{ p.price_min | money_without_currency }}&nbsp;€</span></p>
    {%- else -%}
      {%- render 'ps-comparacion', precio: v.price, producto: p, sin_ahorro: true -%}
    {%- endif -%}
  </div>
  <div class="ps-tar__accion">
    {%- if p.available == false -%}
      <p class="ps-tar__agotado">Agotado por ahora</p>
    {%- elsif p.has_only_default_variant -%}
      {%- form 'product', p, data-ps-anadir: '' -%}
        <input type="hidden" name="id" value="{{ v.id }}">
        <input type="hidden" name="quantity" value="1">
        <button class="ps-btn ps-btn--tinta ps-btn--ancho ps-tar__btn" type="submit" aria-label="Añadir al carrito: {{ nombre | strip | escape }}">Añadir al carrito</button>
      {%- endform -%}
    {%- elsif tipo == 'pack' and selector -%}
      {%- form 'product', p, data-ps-anadir: '' -%}
        <fieldset class="ps-tar__ops">
          <legend class="ps-tar__ops-tit">¿Cuántos packs?</legend>
          {%- assign marcado = false -%}
          {%- for va in p.variants -%}
            {%- if va.available -%}
              <label class="ps-tar__op">
                <input class="ps-tar__op-in" type="radio" name="id" value="{{ va.id }}"{% unless marcado %} checked{% endunless %}>
                <span class="ps-tar__op-c"><span>{{ va.title }}</span><span class="ps-num">{{ va.price | money_without_currency }}&nbsp;€</span></span>
              </label>
              {%- assign marcado = true -%}
            {%- endif -%}
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" value="1">
        <button class="ps-btn ps-btn--tinta ps-btn--ancho ps-tar__btn" type="submit" aria-label="Añadir al carrito: {{ nombre | strip | escape }}">Añadir al carrito</button>
      {%- endform -%}
    {%- else -%}
      {%- if tipo == 'movil' -%}
        <a class="ps-btn ps-btn--borde ps-btn--ancho ps-tar__btn" href="{{ p.url }}" aria-label="Elegir capacidad y color: {{ nombre | strip | escape }}">Elegir capacidad y color</a>
      {%- else -%}
        <a class="ps-btn ps-btn--borde ps-btn--ancho ps-tar__btn" href="{{ p.url }}" aria-label="Elegir cantidad: {{ nombre | strip | escape }}">Elegir cantidad</a>
      {%- endif -%}
    {%- endif -%}
  </div>
</li>
