{%- comment -%}
  Barra fija de compra de la ficha (bloque "Liquid personalizado" al final
  de main-product):
    {%- render 'ps-ficha-barra', product: product, section_id: section.id -%}

  Aparece cuando el boton "Anadir al carrito" de la ficha ya ha quedado por
  encima de la pantalla, y desaparece al volver a el. Su boton pulsa el de
  la ficha, asi que anade la variante y la cantidad elegidas y abre el
  carrito lateral igual que el original. Precio y disponibilidad siguen a
  la variante (evento variantChange de Dawn). Mientras se ve, el boton de
  WhatsApp sube para no taparla.
{%- endcomment -%}
{%- assign v = product.selected_or_first_available_variant -%}
<div class="ps-fb" data-ps-fb aria-hidden="true">
  <div class="ps-fb__in">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 120 | image_tag: class: 'ps-fb__img', loading: 'lazy', alt: '' }}
    {%- endif -%}
    <p class="ps-fb__info">
      <span class="ps-fb__nombre">{{ product.title | split: ' — ' | first }}</span>
      <span class="ps-fb__var" data-ps-fb-var>{% unless product.has_only_default_variant %}{{ v.title }}{% endunless %}</span>
    </p>
    <span class="ps-fb__precio" data-ps-fb-precio>{{ v.price | money_without_currency }}&nbsp;€</span>
    <button type="button" class="ps-fb__btn" data-ps-fb-btn tabindex="-1"{% unless v.available %} disabled{% endunless %}>
      {%- if v.available -%}Añadir al carrito{%- else -%}Sin stock{%- endif -%}
    </button>
  </div>
</div>
<script>
  (function () {
    var bar = document.currentScript.previousElementSibling;
    var info = bar.closest('product-info');
    var sid = '{{ section_id }}';
    var principal = document.getElementById('ProductSubmitButton-' + sid);
    if (!principal || !('IntersectionObserver' in window)) { bar.remove(); return; }
    // Fuera de la columna fija de la ficha, para que position:fixed vaya
    // siempre respecto a la pantalla.
    document.body.appendChild(bar);
    var btn = bar.querySelector('[data-ps-fb-btn]');
    var precio = bar.querySelector('[data-ps-fb-precio]');
    var nombreVar = bar.querySelector('[data-ps-fb-var]');

    function mostrar(si) {
      bar.classList.toggle('is-on', si);
      bar.setAttribute('aria-hidden', si ? 'false' : 'true');
      btn.tabIndex = si ? 0 : -1;
      document.documentElement.classList.toggle('ps-fb-on', si);
    }
    new IntersectionObserver(function (es) {
      var e = es[0];
      mostrar(!e.isIntersecting && e.boundingClientRect.top < 0);
    }).observe(principal);

    btn.addEventListener('click', function () {
      if (!principal.disabled) principal.click();
    });

    // pubsub.js y constants.js de Dawn van con defer: se suscribe cuando
    // ya estan. PUB_SUB_EVENTS es un const global, no cuelga de window.
    function seguirVariante() {
      if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined') return;
      subscribe(PUB_SUB_EVENTS.variantChange, function (ev) {
        var d = ev && ev.data;
        if (!d || d.sectionId !== sid || !d.variant) return;
        var c = d.variant.price;
        precio.textContent = Math.floor(c / 100) + ',' + String(c % 100).padStart(2, '0') + ' €';
        if (nombreVar && d.variant.title !== 'Default Title') nombreVar.textContent = d.variant.title;
        btn.disabled = !d.variant.available;
        btn.textContent = d.variant.available ? 'Añadir al carrito' : 'Sin stock';
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', seguirVariante);
    else seguirVariante();
  })();
</script>

{% stylesheet %}
.ps-fb{position:fixed;left:0;right:0;bottom:0;z-index:30;padding:10px 12px calc(10px + env(safe-area-inset-bottom));
  background:rgba(232,229,223,.94);-webkit-backdrop-filter:saturate(1.4) blur(14px);backdrop-filter:saturate(1.4) blur(14px);
  box-shadow:0 -1px 0 rgba(20,24,36,.12),0 -12px 32px -18px rgba(20,24,36,.4);color:#141824;font-family:var(--font-body-family);
  transform:translateY(110%);visibility:hidden;transition:transform .3s ease,visibility 0s linear .3s}
.ps-fb.is-on{transform:none;visibility:visible;transition:transform .3s ease}
.ps-fb__in{display:flex;align-items:center;gap:14px;max-width:1260px;margin:0 auto}
.ps-fb__img{flex:none;width:48px;height:48px;border-radius:10px;object-fit:contain;background:#fff}
.ps-fb__info{display:flex;flex-direction:column;min-width:0;margin:0 auto 0 0;line-height:1.3}
.ps-fb__nombre{overflow:hidden;white-space:nowrap;text-overflow:ellipsis;font-size:15px;font-weight:700}
.ps-fb__var{font-size:13px;color:#585d6b}
.ps-fb__var:empty{display:none}
.ps-fb__precio{flex:none;font-size:20px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums}
.ps-fb__btn{flex:none;min-height:48px;padding:0 26px;border:0;border-radius:999px;background:#141824;color:#f4f1ea;
  font-family:inherit;font-size:15px;font-weight:700;cursor:pointer;transition:background-color .2s ease}
.ps-fb__btn:hover{background:#262c3d}
.ps-fb__btn[disabled]{opacity:.45;cursor:not-allowed}
.ps-fb__btn:focus-visible{outline:2px solid #7d5f28;outline-offset:3px}
.ps-fb-on .pt-wa{bottom:calc(88px + env(safe-area-inset-bottom))}
@media (max-width:749px){
  .ps-fb__img{display:none}
  .ps-fb__in{gap:12px}
  .ps-fb__nombre{font-size:14px}
  .ps-fb__precio{font-size:18px}
  .ps-fb__btn{padding:0 18px}
}
@media (max-width:389px){.ps-fb__info{display:none}.ps-fb__precio{margin-right:auto}}
@media (prefers-reduced-motion:reduce){.ps-fb,.ps-fb.is-on{transition:none}}
{% endstylesheet %}
