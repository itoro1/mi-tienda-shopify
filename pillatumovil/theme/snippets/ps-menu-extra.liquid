{%- comment -%}
  Bloque bajo los enlaces del menu movil (snippets/header-drawer.liquid):
  los dos packs con foto y precio, para comprar en dos toques segun el
  conector, las garantias y WhatsApp. Tambien da estilo a los enlaces del
  menu: grandes y con separadores, como la portada.
{%- endcomment -%}
<div class="ps-me">
  <p class="ps-me__tit">Packs cargador + cable</p>
  <ul class="ps-me__packs" role="list">
    {%- assign packs = 'pack-cargador-usb-c-20w-cable-usb-c-1m-apple-original,cargador-apple-usb-c' | split: ',' -%}
    {%- for h in packs -%}
      {%- assign p = all_products[h] -%}
      {%- if p == blank -%}{%- continue -%}{%- endif -%}
      <li>
        <a class="ps-me__pack" href="{{ p.url }}">
          {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '', class: 'ps-me__img' }}{%- endif -%}
          <span class="ps-me__nombre">{% if forloop.first %}USB-C{% else %}Lightning{% endif %}</span>
          <span class="ps-me__para">{% if forloop.first %}iPhone 15 o posterior{% else %}iPhone 8 al 14{% endif %}</span>
          <span class="ps-me__precio">{% if p.price_varies %}desde {% endif %}{{ p.price_min | money_without_currency }}&nbsp;€</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  <ul class="ps-me__sellos" role="list">
    <li>{% render 'ps-icono', nombre: 'envio', tam: 16 %}Lo recibe en casa en 24&#8288;-&#8288;48&nbsp;h</li>
    <li>{% render 'ps-icono', nombre: 'devolucion', tam: 16 %}Envío y devolución gratis</li>
    <li>{% render 'ps-icono', nombre: 'garantia', tam: 16 %}Originales de Apple, 3 años de garantía</li>
  </ul>
  <a class="ps-me__wa" href="https://wa.me/34641047539" target="_blank" rel="noopener">{% render 'ps-icono', nombre: 'whatsapp', tam: 18 %}Preguntar por WhatsApp</a>
</div>

{% stylesheet %}
/* Enlaces del menu movil de Dawn */
.menu-drawer .menu-drawer__navigation{padding:8px 0 0}
.menu-drawer .menu-drawer__menu > li + li{border-top:1px solid rgba(244,241,234,.1)}
.menu-drawer .menu-drawer__menu-item{padding:16px 24px;font-size:26px;font-weight:600;letter-spacing:-.025em;line-height:1.15}
.menu-drawer .menu-drawer__menu-item--active{color:#e2cc9a;background:transparent}

.ps-me{padding:20px 24px 8px;color:#f4f1ea;font-family:var(--font-body-family)}
.ps-me__tit{margin:0 0 12px;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:#e2cc9a}
.ps-me__packs{display:grid;grid-template-columns:1fr 1fr;gap:10px;list-style:none;margin:0;padding:0}
.ps-me__pack{display:flex;flex-direction:column;gap:2px;height:100%;padding:10px 10px 12px;border-radius:14px;background:rgba(244,241,234,.06);color:inherit;text-decoration:none}
.ps-me__pack:hover{background:rgba(244,241,234,.1)}
.ps-me__img{width:100%;aspect-ratio:1/1;height:auto;margin-bottom:8px;border-radius:9px;object-fit:contain;background:#fff}
.ps-me__nombre{font-size:16px;font-weight:700}
.ps-me__para{font-size:13px;color:#a9adb8}
.ps-me__precio{margin-top:4px;font-size:15px;font-weight:700;color:#e2cc9a}
.ps-me__sellos{list-style:none;margin:18px 0 0;padding:0;font-size:14px;color:#a9adb8}
.ps-me__sellos li{display:flex;align-items:center;gap:10px;padding:5px 0}
.ps-me__sellos svg{flex:none;color:#c9a86a}
.ps-me__wa{display:flex;align-items:center;justify-content:center;gap:10px;min-height:50px;margin-top:16px;border-radius:999px;box-shadow:inset 0 0 0 1.5px rgba(244,241,234,.5);color:#f4f1ea;font-size:15px;font-weight:700;text-decoration:none}
.ps-me__wa:hover{box-shadow:inset 0 0 0 1.5px #c9a86a}
{% endstylesheet %}
