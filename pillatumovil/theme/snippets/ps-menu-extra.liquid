{%- comment -%}
  Rediseño 2026 · bloque bajo los enlaces del menú móvil
  (snippets/header-drawer.liquid, que lo pinta con los ajustes de la
  cabecera: «Rediseño 2026 · Menú del móvil»).

  - Los dos packs con foto, para qué iPhone es cada uno y su precio: se
    compra en dos toques sabiendo solo el modelo del iPhone.
  - Las tres promesas y el WhatsApp.
  - Además da estilo al menú: pantalla completa en noche, enlaces grandes en
    Unbounded, sin filetes entre ellos (los separa el espacio).

  Los packs se eligen en la cabecera («Packs del menú móvil», hasta dos).
  Si no se ha elegido ninguno, el bloque de packs no sale.
{%- endcomment -%}
{%- liquid
  assign wa = ajustes.ps_whatsapp | default: '34641047539' | remove: ' ' | remove: '+'
  assign hay_packs = false
  if ajustes.ps_packs.size > 0
    assign hay_packs = true
  endif
-%}
<div class="ps-me">
  {%- if hay_packs -%}
    <p class="ps-me__tit">Su pack, según su iPhone</p>
    <ul class="ps-me__packs" role="list">
      {%- for p in ajustes.ps_packs limit: 2 -%}
        {%- liquid
          assign clave_para = 'ps_pack_' | append: forloop.index | append: '_para'
          assign para = ajustes[clave_para]
        -%}
        {%- if p == blank -%}{%- continue -%}{%- endif -%}
        <li>
          <a class="ps-me__pack" href="{{ p.url }}">
            <span class="ps-me__foto">
              {%- if p.featured_image -%}
                {{ p.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', sizes: '45vw', widths: '180,360', class: 'ps-me__img' }}
              {%- endif -%}
            </span>
            <span class="ps-me__para">{{ para }}</span>
            <span class="ps-me__precio">{{ p.price_min | money_without_currency }}&nbsp;€{% if p.price_varies %}<span class="ps-me__u"> el pack</span>{% endif %}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
  <ul class="ps-me__sellos" role="list">
    <li>{% render 'ps-icono', nombre: 'envio', tam: 18 %}En su casa en 24&#8288;-&#8288;48&nbsp;h</li>
    <li>{% render 'ps-icono', nombre: 'devolucion', tam: 18 %}Envío y devolución gratis</li>
    <li>{% render 'ps-icono', nombre: 'garantia', tam: 18 %}Original de Apple, 3&nbsp;años de garantía</li>
  </ul>
  <a class="ps-me__wa" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'ps-icono', nombre: 'whatsapp', tam: 20 %}Preguntar por WhatsApp</a>
</div>

{% stylesheet %}
/* Menú móvil a pantalla completa (Dawn lo coloca bajo la cabecera). */
.menu-drawer{width:100vw;max-width:none;background:#0b0f1a;filter:none;border:0}
.menu-drawer__inner-container{min-height:100%;padding-bottom:calc(24px + env(safe-area-inset-bottom,0px))}
.menu-drawer .menu-drawer__navigation{padding:12px 0 0}
.menu-drawer .menu-drawer__menu > li + li{border-top:0}
.menu-drawer .menu-drawer__menu-item{padding:14px 20px;font-family:var(--font-heading-family);font-size:28px;font-weight:600;letter-spacing:-.03em;line-height:1.1;color:#f4f1ea;transition:opacity 120ms ease}
.menu-drawer .menu-drawer__menu-item:active{opacity:.6}
.menu-drawer .menu-drawer__menu-item--active{color:#d9bb7c;background:transparent}
.menu-drawer .menu-drawer__menu-item .icon-arrow,.menu-drawer .menu-drawer__menu-item .svg-wrapper{color:#d9bb7c}
.menu-drawer__utility-links{background:transparent;padding:8px 20px 0}
.menu-drawer__account{font-size:16px;color:#b9bcc6}

.ps-me{padding:24px 20px 0;color:#f4f1ea;font-family:var(--font-body-family)}
.ps-me__tit{margin:0 0 14px;font-size:17px;font-weight:700;color:#f4f1ea}
.ps-me__packs{display:grid;grid-template-columns:1fr 1fr;gap:10px;list-style:none;margin:0;padding:0}
.ps-me__pack{display:flex;flex-direction:column;gap:4px;height:100%;padding:0 0 14px;background:#151b2c;color:inherit;text-decoration:none;transition:transform 120ms cubic-bezier(.23,1,.32,1)}
.ps-me__pack:active{transform:scale(.97)}
.ps-me__foto{display:block;background:#f3f1ec;margin-bottom:10px}
.ps-me__img{display:block;width:100%;aspect-ratio:1/1;height:auto;object-fit:contain;mix-blend-mode:multiply}
.ps-me__para{padding:0 12px;font-size:15px;line-height:1.3;color:#f4f1ea}
.ps-me__precio{padding:0 12px;font-family:var(--font-heading-family);font-size:18px;font-weight:600;letter-spacing:-.02em;color:#d9bb7c}
.ps-me__u{font-family:var(--font-body-family);font-size:14px;font-weight:400;letter-spacing:0;color:#b9bcc6}
.ps-me__sellos{list-style:none;margin:22px 0 0;padding:0;font-size:16px;color:#f4f1ea}
.ps-me__sellos li{display:flex;align-items:center;gap:12px;padding:6px 0}
.ps-me__sellos svg{flex:none;color:#c9a86a}
.ps-me__wa{display:flex;align-items:center;justify-content:center;gap:10px;min-height:56px;margin-top:20px;border-radius:999px;background:#f4f1ea;color:#0b0f1a;font-size:17px;font-weight:700;text-decoration:none;transition:transform 120ms cubic-bezier(.23,1,.32,1)}
.ps-me__wa:active{transform:scale(.97)}
{% endstylesheet %}
