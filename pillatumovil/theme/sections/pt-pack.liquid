{%- comment -%}
  El pack como una suma: cada pieza suelta con su precio, el total por
  separado y, debajo, el precio del pack. Todo sale de los productos:
  - Piezas: lista "Productos sueltos que incluye".
  - Pack: precio del producto del pack (la opcion mas barata, 1 unidad).
  - En Apple: metacampo custom.pvp_apple del pack.
  Una fila de comparacion solo sale si es mas cara que el pack, para que
  nunca se anuncie un ahorro que no existe.
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.pack
  assign suelto = 0
  for s in section.settings.incluye
    assign suelto = suelto | plus: s.price
  endfor
  assign pa = p.metafields.custom.pvp_apple.value
  assign pa_cents = 0
  if pa != blank
    assign pa_cents = pa | remove: '€' | remove: ' ' | remove: '.' | replace: ',', '.' | strip | times: 100 | round
  endif
-%}
<section class="pt pt-sec pt-pack-sec" style="--pt-accent:{{ settings.pt_accent | default: '#0e7c3a' }}">
  <div class="pt-wrap pt-pack">
    <div class="pt-pack__copy">
      <h2 class="pt-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="pt-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    {%- if p != blank -%}
      <div class="pt-sum">
        <ul class="pt-sum__items" role="list">
          {%- for s in section.settings.incluye -%}
            <li>
              <span class="pt-sum__thumb">{%- if s.featured_image -%}{{ s.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}{%- endif -%}</span>
              <span class="pt-sum__name">{% unless forloop.first %}<b aria-hidden="true">+ </b>{% endunless %}{{ s.title }}</span>
              <span class="pt-sum__amt">{{ s.price | money }}</span>
            </li>
          {%- endfor -%}
        </ul>
        <dl class="pt-sum__totals">
          {%- if suelto > p.price -%}
            <div><dt>Por separado</dt><dd><s>{{ suelto | money }}</s></dd></div>
          {%- endif -%}
          {%- if pa_cents > p.price -%}
            <div><dt>En Apple</dt><dd><s>{{ pa_cents | money }}</s></dd></div>
          {%- endif -%}
          <div class="pt-sum__total"><dt>{{ section.settings.etiqueta_pack }}</dt><dd>{{ p.price | money }}</dd></div>
        </dl>
        {%- if pa_cents > p.price -%}
          <p class="pt-sum__save"><span class="pt-save">Ahorras {{ pa_cents | minus: p.price | money }} frente a Apple</span></p>
        {%- endif -%}
        <a class="pt-btn pt-sum__btn" href="{{ p.url }}">{{ section.settings.boton }}</a>
      </div>
    {%- else -%}
      <p class="pt-pack__empty">Elige el producto del pack en el editor de temas para mostrar la suma.</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.pt-pack-sec{padding-top:clamp(32px,4vw,56px)}
.pt-pack{display:grid;grid-template-columns:1fr minmax(0,520px);gap:clamp(32px,6vw,88px);align-items:start}
.pt-pack__copy{padding-top:28px}
.pt-sum{padding:28px;border-radius:var(--pt-r-panel);background:var(--pt-box)}
.pt-sum__items{list-style:none;margin:0;padding:0}
.pt-sum__items li{display:grid;grid-template-columns:64px 1fr auto;gap:16px;align-items:center;padding:10px 0}
.pt-sum__thumb{display:grid;place-items:center;aspect-ratio:1/1;border-radius:10px;background:#fff}
.pt-sum__thumb img{width:88%;height:88%;object-fit:contain}
.pt-sum__name{font-size:16px;font-weight:600;line-height:1.3}
.pt-sum__name b{color:var(--pt-muted)}
.pt-sum__amt{font-size:17px;font-weight:700}
.pt-sum__totals{margin:12px 0 0;padding-top:12px;border-top:3px solid var(--pt-ink)}
.pt-sum__totals div{display:flex;justify-content:space-between;align-items:baseline;padding:4px 0}
.pt-sum__totals dt{font-size:16px;color:var(--pt-muted)}
.pt-sum__totals dd{margin:0;font-size:17px;color:var(--pt-muted)}
.pt-sum__total{margin-top:6px}
.pt-sum__total dt{font-size:18px;font-weight:800;color:var(--pt-ink)}
.pt-sum__total dd{font-size:40px;font-weight:800;letter-spacing:-.03em;line-height:1;color:var(--pt-ink)}
.pt-sum__save{margin:8px 0 0}
.pt-sum__save .pt-save{margin-top:0}
.pt-sum__save{display:flex;justify-content:flex-end}
.pt-sum__btn{width:100%;margin-top:20px}
.pt-pack__empty{color:var(--pt-muted)}
@media (max-width:989px){.pt-pack{grid-template-columns:1fr}}
@media (max-width:749px){
  .pt-sum{padding:18px}
  .pt-sum__items li{grid-template-columns:52px 1fr auto;gap:12px}
  .pt-sum__name{font-size:15px}
  .pt-sum__total dd{font-size:34px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · Pack",
  "tag": "div",
  "class": "pt-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Cargador y cable, juntos por menos." },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Los iPhone ya no traen cargador en la caja. Con el pack tienes el adaptador de 20 W y el cable, los dos originales de Apple." },
    { "type": "product", "id": "pack", "label": "Producto del pack", "info": "De aquí salen el precio del pack y el PVP de Apple." },
    { "type": "product_list", "id": "incluye", "label": "Productos sueltos que incluye", "limit": 4, "info": "Se listan como una suma. Si lo dejas vacío, solo sale el precio del pack." },
    { "type": "text", "id": "etiqueta_pack", "label": "Etiqueta del precio del pack", "default": "En pack" },
    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Ver el pack" }
  ],
  "presets": [{ "name": "PT · Pack" }]
}
{% endschema %}
