{%- comment -%}
  Lista de precios: una fila por producto con nuestro precio y el de Apple
  en columnas, para comparar de un vistazo. Los productos se eligen a mano
  o, si la lista esta vacia, salen los de una coleccion.
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign lista = section.settings.productos
  if lista == blank or lista.size == 0
    assign lista = section.settings.coleccion.products
  endif
  assign mostrar = true
  if lista == blank or lista.size == 0
    unless request.design_mode
      assign mostrar = false
    endunless
  endif
-%}
{%- if mostrar -%}
<section class="pt pt-sec pt-list-sec" style="--pt-accent:{{ settings.pt_accent | default: '#c9a86a' }}">
  <div class="pt-wrap">
    <div class="pt-list__head">
      <div>
        <h2 class="pt-h2">{{ section.settings.titulo }}</h2>
        {%- if section.settings.texto != blank -%}<p class="pt-lead">{{ section.settings.texto }}</p>{%- endif -%}
      </div>
      {%- if section.settings.ver_todo != blank -%}
        <a class="pt-link" href="{{ section.settings.coleccion.url | default: routes.all_products_collection_url }}">{{ section.settings.ver_todo }}</a>
      {%- endif -%}
    </div>

    <ol class="pt-list" role="list">
      <li class="pt-list__cols" aria-hidden="true">
        <span></span><span>Producto</span><span>En Apple</span><span>Aquí</span><span></span>
      </li>
      {%- for p in lista limit: section.settings.maximo -%}
        {%- liquid
          assign pa = p.metafields.custom.pvp_apple.value
          assign pa_cents = 0
          if pa != blank
            assign pa_cents = pa | remove: '€' | remove: ' ' | remove: '.' | replace: ',', '.' | strip | times: 100 | round
          endif
          assign ahorro = pa_cents | minus: p.price
        -%}
        <li class="pt-list__row">
          <a class="pt-list__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
            {%- if p.featured_image -%}
              {{ p.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '120px', alt: '' }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'pt-ph' }}
            {%- endif -%}
          </a>
          <div class="pt-list__name">
            <a href="{{ p.url }}">{{ p.title }}</a>
            {%- unless p.available -%}<span class="pt-list__out">Sin stock ahora mismo</span>{%- endunless -%}
          </div>
          <div class="pt-list__apple">
            {%- if pa != blank -%}<span class="pt-list__k">En Apple</span><s>{{ pa_cents | money_without_currency }} €</s>{%- endif -%}
          </div>
          <div class="pt-list__ours">
            <span class="pt-list__k">Aquí</span>
            <strong>{% if p.price_varies %}<small>desde </small>{% endif %}{{ p.price | money_without_currency }}<span class="pt-eur">€</span></strong>
            {%- if ahorro > 0 -%}<span class="pt-save">Ahorra {{ ahorro | money_without_currency }} €</span>{%- endif -%}
          </div>
          <a class="pt-btn pt-btn--line pt-list__btn" href="{{ p.url }}">{% if p.has_only_default_variant %}Comprar{% else %}Elegir cantidad{% endif %}</a>
        </li>
      {%- else -%}
        <li class="pt-list__row pt-list__row--empty">Elige los productos de esta lista en el editor de temas.</li>
      {%- endfor -%}
    </ol>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
.pt-list-sec{padding-bottom:clamp(24px,3vw,40px)}
.pt-list__head{display:flex;justify-content:space-between;align-items:flex-end;gap:16px 32px;flex-wrap:wrap;margin-bottom:28px}
.pt-list{list-style:none;margin:0;padding:0;border-top:1px solid rgba(201,168,106,.55)}
.pt-list__cols,.pt-list__row{display:grid;grid-template-columns:112px minmax(0,1fr) 120px 170px 180px;gap:24px;align-items:center}
.pt-list__cols{padding:10px 0;font-size:14px;color:var(--pt-muted);border-bottom:1px solid var(--pt-line)}
.pt-list__row{position:relative;padding:16px 0;border-bottom:1px solid var(--pt-line)}
.pt-list__row--empty{display:block;color:var(--pt-muted)}
.pt-list__img{display:grid;place-items:center;aspect-ratio:1/1;border-radius:16px;background:var(--pt-tile);overflow:hidden}
.pt-list__img img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
.pt-list__name a{font-size:18px;font-weight:600;line-height:1.35;color:var(--pt-ink);text-decoration:none}
.pt-list__name a:hover{text-decoration:underline;text-underline-offset:3px}
.pt-list__out{display:block;margin-top:4px;font-size:14px;color:var(--pt-muted)}
.pt-list__k{display:none}
.pt-list__apple{font-size:17px;color:var(--pt-muted)}
.pt-list__ours{display:flex;flex-direction:column;align-items:flex-start}
.pt-list__ours strong{font-family:var(--font-heading-family);font-size:30px;font-weight:var(--font-heading-weight,500);color:var(--pt-oro-claro)}
.pt-list__ours small{font-size:14px;font-weight:600;color:var(--pt-muted);letter-spacing:0}
.pt-list__btn{width:100%}
@media (max-width:989px){
  .pt-list__cols{display:none}
  .pt-list__row{grid-template-columns:96px minmax(0,1fr) minmax(0,1fr);grid-template-areas:"img name name" "img apple ours";gap:8px 16px}
  .pt-list__img{grid-area:img;align-self:start}
  .pt-list__name{grid-area:name}
  .pt-list__apple{grid-area:apple;align-self:start}
  .pt-list__ours{grid-area:ours;align-self:start}
  .pt-list__btn{display:none}
  .pt-list__name a::after{content:"";position:absolute;inset:0}
  .pt-list__k{display:block;font-size:13px;color:var(--pt-muted)}
  .pt-list__name a{font-size:16px}
  .pt-list__ours strong{font-size:24px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · Lista de precios",
  "tag": "div",
  "class": "pt-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Precio aquí y en Apple" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Los mismos productos originales, con el precio de Apple al lado." },
    { "type": "product_list", "id": "productos", "label": "Productos", "limit": 12, "info": "Elige y ordena los productos. Si lo dejas vacío, salen los de la colección de abajo." },
    { "type": "collection", "id": "coleccion", "label": "Colección (si no eliges productos)" },
    { "type": "range", "id": "maximo", "label": "Máximo de productos", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "text", "id": "ver_todo", "label": "Texto del enlace a todos los productos", "default": "Ver todos los productos" }
  ],
  "presets": [{ "name": "PT · Lista de precios" }]
}
{% endschema %}
