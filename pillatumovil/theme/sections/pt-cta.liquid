{%- comment -%}
  Cierre de la portada: una franja en tinta con una frase y un boton.
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
<section class="pt pt-sec pt--ink pt-close" style="--pt-accent:{{ settings.pt_accent | default: '#c9a86a' }}">
  <div class="pt-wrap pt-close__grid">
    <div>
      <h2 class="pt-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="pt-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>
    <div class="pt-close__actions">
      {%- if section.settings.boton != blank -%}
        <a class="pt-btn" href="{{ section.settings.enlace | default: '#encuentra' }}">{{ section.settings.boton }}</a>
      {%- endif -%}
      {%- if section.settings.boton_2 != blank and section.settings.enlace_2 != blank -%}
        <a class="pt-link pt-close__link" href="{{ section.settings.enlace_2 }}" target="_blank" rel="noopener">{{ section.settings.boton_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pt-close__grid{display:flex;justify-content:space-between;align-items:center;gap:24px 48px;flex-wrap:wrap}
.pt-close .pt-h2{max-width:18ch}
.pt-close__actions{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px}
.pt-close{border-top:1px solid rgba(201,168,106,.28)}
.pt-close__link{color:var(--pt-ink)}
@media (max-width:749px){.pt-close__actions{width:100%}.pt-close__actions .pt-btn{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · Cierre",
  "tag": "div",
  "class": "pt-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "¿Aún no sabe cuál necesita?" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Mire el puerto de carga de su iPhone y elija. O pregúntenos por WhatsApp y se lo decimos." },
    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Elegir cargador" },
    { "type": "url", "id": "enlace", "label": "Enlace del botón", "info": "Si lo dejas vacío, sube al buscador «¿Qué conector tiene tu iPhone?»." },
    { "type": "text", "id": "boton_2", "label": "Enlace secundario", "default": "Preguntar por WhatsApp" },
    { "type": "url", "id": "enlace_2", "label": "Destino del enlace secundario", "info": "Por ejemplo https://wa.me/34641047539. Si lo dejas vacío, no sale." }
  ],
  "presets": [{ "name": "PT · Cierre" }]
}
{% endschema %}
