{%- comment -%}
  Cierre de la portada: una franja en tinta con una frase y un boton.
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
<section class="pt pt-sec pt--ink pt-close" style="--pt-accent:{{ settings.pt_accent | default: '#0e7c3a' }}">
  <div class="pt-wrap pt-close__grid">
    <div>
      <h2 class="pt-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="pt-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>
    {%- if section.settings.boton != blank -%}
      <a class="pt-btn pt-btn--light" href="{{ section.settings.enlace | default: '#encuentra' }}">{{ section.settings.boton }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.pt-close__grid{display:flex;justify-content:space-between;align-items:center;gap:24px 48px;flex-wrap:wrap}
.pt-close .pt-h2{max-width:18ch}
@media (max-width:749px){.pt-close__grid .pt-btn{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · Cierre",
  "tag": "div",
  "class": "pt-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "¿Aún no sabes cuál te toca?" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Mira el puerto de carga de tu iPhone y elige. Tardas diez segundos." },
    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Elegir mi cargador" },
    { "type": "url", "id": "enlace", "label": "Enlace del botón", "info": "Si lo dejas vacío, sube al buscador «¿Qué conector tiene tu iPhone?»." }
  ],
  "presets": [{ "name": "PT · Cierre" }]
}
{% endschema %}
