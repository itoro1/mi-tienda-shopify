{%- comment -%}
  Pagina no encontrada: lo dice claro y ofrece por donde seguir. Debajo, en
  la plantilla, los productos (ps-precios).
{%- endcomment -%}
{{ 'ps-base.css' | asset_url | stylesheet_tag }}
<section class="ps ps--piedra ps-404">
  <div class="ps-wrap">
    <p class="ps-404__cod">Error 404</p>
    <h1 class="ps-h1">{{ section.settings.titulo }}</h1>
    <p class="ps-lead">{{ section.settings.texto }}</p>
    <div class="ps-btns">
      <a class="ps-btn ps-btn--tinta" href="{{ routes.all_products_collection_url }}">Ver todos los productos</a>
      <a class="ps-link" href="/pages/que-cable-necesito">¿Qué cable necesito?</a>
    </div>
    <form class="ps-404__buscar" action="{{ routes.search_url }}" method="get" role="search">
      <label class="ps-visually-hidden" for="Ps404Buscar">Buscar en la tienda</label>
      <input id="Ps404Buscar" type="search" name="q" placeholder="O busque: cargador, cable USB-C…">
      <button type="submit">Buscar</button>
    </form>
  </div>
</section>

{% stylesheet %}
.ps-404{padding:clamp(56px,8vw,120px) 0 clamp(48px,6vw,88px)}
.ps-404__cod{margin:0 0 14px;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ps-oro-tinta)}
.ps-404__buscar{display:flex;align-items:center;max-width:520px;margin-top:32px;padding:5px;border-radius:999px;background:#fff;box-shadow:inset 0 0 0 1px var(--ps-linea)}
.ps-404__buscar:focus-within{box-shadow:inset 0 0 0 2px var(--ps-tinta)}
.ps-404__buscar input{flex:1;min-width:0;height:46px;padding:0 16px;border:0;background:transparent;color:var(--ps-tinta);font:inherit;font-size:16px}
.ps-404__buscar input:focus{outline:0}
.ps-404__buscar button{height:46px;padding:0 22px;border:0;border-radius:999px;background:var(--ps-tinta);color:var(--ps-marfil);font:inherit;font-size:15px;font-weight:700;cursor:pointer}
{% endstylesheet %}

{% schema %}
{
  "name": "PS · No encontrada",
  "tag": "div",
  "class": "ps-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Esta página no existe." },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Puede que el enlace esté mal escrito o que la página se haya movido. Lo que sí tenemos, aquí abajo." }
  ]
}
{% endschema %}
