{%- comment -%}
  Tres entradas grandes con foto de estudio: Cargador, Cables, Packs. El
  precio "desde" sale del producto o de la coleccion elegida.
{%- endcomment -%}
{{ 'ps-base.css' | asset_url | stylesheet_tag }}
<section class="ps ps--{{ section.settings.fondo }} ps-sec ps-cat">
  <div class="ps-wrap">
    <div class="ps-cat__cab">
      <h2 class="ps-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="ps-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>
    <ul class="ps-cat__lista" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.coleccion
          assign p = block.settings.producto
          assign url = block.settings.enlace
          if url == blank and c != blank
            assign url = c.url
          elsif url == blank and p != blank
            assign url = p.url
          endif
          assign desde = nil
          if p != blank
            assign desde = p.price
          elsif c != blank and c.products_count > 0
            assign desde = c.products | map: 'price' | sort | first
          endif
        -%}
        <li {{ block.shopify_attributes }}>
          <a class="ps-cat__item" href="{{ url | default: routes.all_products_collection_url }}">
            <span class="ps-foto ps-cat__foto">
              {%- if block.settings.imagen != blank -%}
                {{ block.settings.imagen | image_url: width: 1100 | image_tag: loading: 'lazy', widths: '400, 700, 900, 1100', sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw', alt: '' }}
              {%- endif -%}
            </span>
            <span class="ps-cat__pie">
              <span class="ps-h3 ps-cat__nombre">{{ block.settings.titulo }}</span>
              {%- if desde -%}<span class="ps-cat__desde">Desde {{ desde | money_without_currency }} €</span>{%- endif -%}
            </span>
            {%- if block.settings.texto != blank -%}<span class="ps-cat__txt">{{ block.settings.texto }}</span>{%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.ps-cat__cab{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:16px 48px;margin-bottom:clamp(32px,4vw,56px)}
.ps-cat__cab .ps-lead{margin:0;max-width:40ch}
.ps-cat__lista{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:clamp(16px,2vw,28px)}
.ps-cat__item{display:block;color:inherit;text-decoration:none}
.ps-cat__foto{display:block;aspect-ratio:1/1}
.ps-cat__foto img{transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.ps-cat__item:hover .ps-cat__foto img{transform:scale(1.035)}
.ps-cat__pie{display:flex;justify-content:space-between;align-items:baseline;gap:12px;margin-top:18px}
.ps-cat__desde{font-size:15px;color:var(--ps-texto-2);white-space:nowrap}
.ps-cat__txt{display:block;margin-top:6px;font-size:15px;color:var(--ps-texto-2);max-width:36ch}
.ps-cat__item:hover .ps-cat__nombre{text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:5px;text-decoration-color:var(--ps-oro)}
@media (max-width:989px){.ps-cat__lista{grid-template-columns:1fr 1fr}}
@media (max-width:599px){.ps-cat__lista{grid-template-columns:1fr}}
{% endstylesheet %}

{% schema %}
{
  "name": "PS · Categorías",
  "tag": "div",
  "class": "ps-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Elija lo que necesita" },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "select", "id": "fondo", "label": "Fondo", "default": "piedra", "options": [
      { "value": "piedra", "label": "Piedra" }, { "value": "papel", "label": "Papel" }, { "value": "noche", "label": "Noche" } ] }
  ],
  "blocks": [
    {
      "type": "categoria",
      "name": "Categoría",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Nombre", "default": "Cargador" },
        { "type": "text", "id": "texto", "label": "Una línea" },
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "collection", "id": "coleccion", "label": "Colección", "info": "Enlace y precio «desde». O elige un producto." },
        { "type": "product", "id": "producto", "label": "Producto (en vez de colección)" },
        { "type": "url", "id": "enlace", "label": "Enlace propio (opcional)" }
      ]
    }
  ],
  "presets": [{ "name": "PS · Categorías" }]
}
{% endschema %}
