{%- comment -%}
  Boton flotante de WhatsApp. Vive en el grupo del pie (footer-group), asi
  que sale en todas las paginas sin tocar layout/theme.liquid.

  Tambien carga assets/pt-dawn.css, los retoques globales que llevan el
  diseno de la portada a las paginas de Dawn (producto, coleccion, contacto).
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
{{ 'pt-dawn.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign numero = section.settings.numero | remove: '+' | remove: ' ' | remove: '-'
  assign texto = section.settings.mensaje | url_encode
-%}
{%- if section.settings.mostrar and numero != blank -%}
  <a class="pt-wa" href="https://wa.me/{{ numero }}{% if texto != blank %}?text={{ texto }}{% endif %}" target="_blank" rel="noopener" aria-label="{{ section.settings.etiqueta | escape }}">
    <svg viewBox="0 0 32 32" width="26" height="26" aria-hidden="true" focusable="false"><path fill="currentColor" d="M16 3a13 13 0 0 0-11.2 19.6L3 29l6.6-1.7A13 13 0 1 0 16 3Zm0 23.7a10.7 10.7 0 0 1-5.5-1.5l-.4-.2-3.9 1 1-3.8-.2-.4A10.7 10.7 0 1 1 16 26.7Zm5.9-8c-.3-.2-1.9-.9-2.2-1-.3-.1-.5-.2-.7.2l-1 1.2c-.2.2-.4.2-.7.1a8.8 8.8 0 0 1-4.4-3.8c-.3-.6.3-.5.9-1.7.1-.2 0-.4 0-.5l-1-2.4c-.3-.6-.5-.5-.7-.5h-.6a1.2 1.2 0 0 0-.9.4 3.7 3.7 0 0 0-1.1 2.7 6.4 6.4 0 0 0 1.3 3.4 14.6 14.6 0 0 0 5.6 4.9c2.1.9 2.9 1 4 .8a3.4 3.4 0 0 0 2.2-1.6 2.8 2.8 0 0 0 .2-1.6c-.1-.2-.3-.3-.6-.4Z"/></svg>
    <span class="pt-wa__txt">{{ section.settings.etiqueta }}</span>
  </a>
{%- endif -%}

{% stylesheet %}
/* Rediseño 2026: noche con el símbolo en verde de WhatsApp (se reconoce sin
   gritar), sombra solo porque flota, respuesta al pulsar y fuera de la zona
   de la barra de inicio del iPhone. */
.pt-wa{position:fixed;right:calc(16px + env(safe-area-inset-right,0px));bottom:calc(16px + env(safe-area-inset-bottom,0px));z-index:40;display:flex;align-items:center;gap:10px;height:56px;padding:0 22px 0 16px;border-radius:999px;background:#0b0f1a;color:#f4f1ea;font-family:var(--font-body-family);font-size:16px;font-weight:700;text-decoration:none;box-shadow:0 12px 32px -12px rgba(11,15,26,.55),0 0 0 1px rgba(244,241,234,.12);transition:transform 120ms cubic-bezier(.23,1,.32,1),bottom 300ms cubic-bezier(.23,1,.32,1);touch-action:manipulation;-webkit-user-select:none;user-select:none}
.pt-wa svg{color:#25d366;flex:none}
.pt-wa:active{transform:scale(.95)}
.pt-wa:focus-visible{outline:2px solid #c9a86a;outline-offset:3px}
@media (hover:hover) and (pointer:fine){.pt-wa:hover{transform:translateY(-2px)}}
@media (max-width:749px){.pt-wa{width:56px;padding:0;justify-content:center}.pt-wa__txt{display:none}}
/* Mientras está abierto el buscador, el menú o el carrito, el botón se aparta. */
body:has(details-modal > details[open], details.menu-drawer-container[open], cart-drawer.active) .pt-wa{opacity:0;pointer-events:none;transform:scale(.9);transition:opacity 160ms ease,transform 160ms ease}
@media print{.pt-wa{display:none}}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · WhatsApp",
  "tag": "div",
  "class": "pt-section",
  "settings": [
    { "type": "checkbox", "id": "mostrar", "label": "Mostrar el botón", "default": true },
    { "type": "text", "id": "numero", "label": "Número de WhatsApp", "default": "34641047539", "info": "Con prefijo de país, sin el +. Ejemplo: 34641047539" },
    { "type": "text", "id": "etiqueta", "label": "Texto del botón", "default": "Consúltenos" },
    { "type": "text", "id": "mensaje", "label": "Mensaje que se escribe solo", "default": "Hola, quería hacer una consulta sobre un cargador." }
  ],
  "presets": [{ "name": "PT · WhatsApp" }]
}
{% endschema %}
