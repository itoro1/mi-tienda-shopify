{%- comment -%}
  Portada. Titular, la bateria y el producto estrella con su precio.

  La bateria es el unico elemento animado de la pagina: al entrar se carga
  una vez hasta el porcentaje del ajuste. Por defecto ensena el dato de Apple
  para el cargador de 20 W (hasta el 50 % en unos 30 minutos).

  Foto, precio y PVP de Apple salen del producto elegido; no hay precios
  escritos a mano.
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.producto
  assign pct = section.settings.bateria_pct
  assign con_media = true
  if p == blank and section.settings.imagen == blank and request.design_mode == false
    assign con_media = false
  endif
-%}
<section class="pt pt-hero" style="--pt-accent:{{ settings.pt_accent | default: '#c9a86a' }}">
  <div class="pt-wrap pt-hero__grid{% unless con_media %} pt-hero__grid--solo{% endunless %}">
    <div class="pt-hero__copy">
      <h1 class="pt-h1">{{ section.settings.titulo }}</h1>
      {%- if section.settings.texto != blank -%}<p class="pt-lead">{{ section.settings.texto }}</p>{%- endif -%}

      {%- if section.settings.mostrar_bateria -%}
        <figure class="pt-batt">
          <div class="pt-batt__shell" role="img" aria-label="Batería al {{ pct }} %">
            <div class="pt-batt__body">
              <span class="pt-batt__fill" style="--pct:{{ pct }}%"></span>
              <span class="pt-batt__num">
                <svg viewBox="0 0 12 20" width="10" height="16" aria-hidden="true"><path d="M7.5 0 0 11.5h5L4 20l8-12H7z" fill="currentColor"/></svg>
                {{ pct }} %
              </span>
            </div>
            <span class="pt-batt__cap" aria-hidden="true"></span>
          </div>
          {%- if section.settings.bateria_texto != blank -%}<figcaption class="pt-batt__note">{{ section.settings.bateria_texto }}</figcaption>{%- endif -%}
        </figure>
      {%- endif -%}

      <div class="pt-btns">
        {%- if section.settings.boton_1 != blank -%}
          <a class="pt-btn" href="{{ section.settings.enlace_1 | default: '#encuentra' }}">{{ section.settings.boton_1 }}</a>
        {%- endif -%}
        {%- if section.settings.boton_2 != blank -%}
          <a class="pt-link" href="{{ section.settings.enlace_2 | default: routes.all_products_collection_url }}">{{ section.settings.boton_2 }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if con_media -%}
    <div class="pt-hero__media">
      <div class="pt-hero__photo">
        {%- if section.settings.imagen != blank -%}
          {{ section.settings.imagen | image_url: width: 1100 | image_tag: class: 'pt-hero__img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 45vw, 100vw', widths: '550, 800, 1100' }}
        {%- elsif p.featured_image -%}
          {%- assign alt = p.featured_image.alt | default: p.title -%}
          {{ p.featured_image | image_url: width: 1100 | image_tag: class: 'pt-hero__img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 45vw, 100vw', widths: '550, 800, 1100', alt: alt }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pt-ph pt-hero__img' }}
        {%- endif -%}
      </div>
      {%- if p != blank -%}
        <a class="pt-hero__tag" href="{{ p.url }}">
          <span class="pt-hero__name">{{ p.title }}</span>
          {%- render 'pt-precio', product: p -%}
        </a>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.pt-hero{padding:clamp(40px,6vw,88px) 0 clamp(48px,7vw,96px)}
.pt-hero__grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,6vw,88px);align-items:center}
.pt-hero__grid--solo{grid-template-columns:minmax(0,760px)}

/* La bateria: carcasa, polo y relleno verde que se carga al entrar. */
.pt-batt{margin:36px 0 0;max-width:460px}
.pt-batt__shell{display:flex;align-items:center;gap:4px}
.pt-batt__body{position:relative;flex:1;height:56px;padding:5px;border:3px solid var(--pt-ink);border-radius:16px}
.pt-batt__fill{display:block;height:100%;width:var(--pct);border-radius:9px;background:var(--pt-battery);animation:pt-charge 1.8s cubic-bezier(.2,.7,.2,1) .25s both}
@keyframes pt-charge{from{width:6%}to{width:var(--pct)}}
.pt-batt__num{position:absolute;inset:0;padding-left:20px;display:flex;align-items:center;justify-content:flex-start;gap:6px;font-size:20px;font-weight:800;letter-spacing:-.01em;color:var(--pt-ink)}
.pt-batt__cap{width:7px;height:20px;border-radius:0 5px 5px 0;background:var(--pt-ink)}
.pt-batt__note{margin:12px 0 0;font-size:14px;line-height:1.45;color:var(--pt-muted)}

.pt-hero__media{display:flex;flex-direction:column;gap:12px}
.pt-hero__photo{aspect-ratio:1/1;border-radius:var(--pt-r-panel);background:var(--pt-box);display:grid;place-items:center;overflow:hidden}
.pt-hero__img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
.pt-hero__tag{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;padding:16px 4px 0;text-decoration:none;color:inherit;border-top:3px solid var(--pt-ink)}
.pt-hero__name{font-size:16px;font-weight:700;max-width:22ch}
.pt-hero__tag .pt-price{align-items:flex-end;text-align:right}
.pt-hero__tag:hover .pt-hero__name{text-decoration:underline;text-underline-offset:3px}

@media (max-width:989px){
  .pt-hero__grid{grid-template-columns:1fr}
  .pt-hero__photo{aspect-ratio:5/4}
}
@media (max-width:749px){
  .pt-batt__body{height:48px}
  .pt-hero__tag{flex-direction:column;align-items:flex-start}
  .pt-hero__tag .pt-price{align-items:flex-start;text-align:left}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · Portada",
  "tag": "div",
  "class": "pt-section",
  "settings": [
    { "type": "header", "content": "Texto" },
    { "type": "text", "id": "titulo", "label": "Titular", "default": "El cargador original que su iPhone necesita." },
    { "type": "textarea", "id": "texto", "label": "Texto de apoyo", "default": "Cargadores y cables originales de Apple, nuevos y en su caja, por menos de lo que cuestan en Apple. Con 3 años de garantía legal." },
    { "type": "header", "content": "Batería" },
    { "type": "checkbox", "id": "mostrar_bateria", "label": "Mostrar la batería", "default": true },
    { "type": "range", "id": "bateria_pct", "label": "Hasta qué porcentaje se carga", "min": 10, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "text", "id": "bateria_texto", "label": "Texto bajo la batería", "default": "Hasta el 50 % en unos 30 minutos con el cargador de 20 W, según Apple." },
    { "type": "header", "content": "Botones" },
    { "type": "text", "id": "boton_1", "label": "Botón principal", "default": "Elegir cargador" },
    { "type": "url", "id": "enlace_1", "label": "Enlace del botón principal", "info": "Si lo dejas vacío, baja al buscador «¿Qué conector tiene tu iPhone?»." },
    { "type": "text", "id": "boton_2", "label": "Enlace secundario", "default": "Ver todos los productos" },
    { "type": "url", "id": "enlace_2", "label": "Destino del enlace secundario" },
    { "type": "header", "content": "Producto" },
    { "type": "product", "id": "producto", "label": "Producto estrella", "info": "De aquí salen la foto, el precio y el PVP de Apple." },
    { "type": "image_picker", "id": "imagen", "label": "Imagen propia (opcional)", "info": "Sustituye a la foto del producto." }
  ],
  "presets": [{ "name": "PT · Portada" }]
}
{% endschema %}
