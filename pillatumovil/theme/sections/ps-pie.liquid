{%- comment -%}
  Rediseño 2026 · Pie de página: «el nombre sobre la última foto».

  La última foto de la tienda (por defecto, el cargador en la mesilla de
  noche) a todo el ancho y oscurecida por igual, para que el texto se lea en
  cualquier punto. Encima:
  - arriba, los menús (Tienda y Ayuda), el contacto con WhatsApp y el
    boletín;
  - abajo, el logo a todo el ancho, como cierre.
  Debajo de la foto, en noche: los medios de pago activos, el ©, las
  políticas que existan (Configuración > Políticas) y la nota de Apple.

  El boletín es el formulario de cliente de Shopify con la etiqueta
  «newsletter», igual que el de Dawn: las altas aparecen en Clientes.
  Todo se cambia en el editor (PS · Pie de página).
{%- endcomment -%}
{%- liquid
  assign wa = section.settings.whatsapp | remove: ' ' | remove: '+'
-%}
<footer class="ps ps--noche ps-pie">
  <div class="ps-pie__escena">
    {%- if section.settings.foto != blank -%}
      {%- assign alt_foto = section.settings.foto.alt | default: '' -%}
      <div class="ps-pie__foto">
        {{ section.settings.foto | image_url: width: 2400 | image_tag:
          loading: 'lazy', sizes: '100vw', widths: '800,1200,1600,2000,2400',
          alt: alt_foto, class: 'ps-pie__img' }}
      </div>
    {%- endif -%}
    <div class="ps-wrap ps-pie__capa">
      <div class="ps-pie__contacto">
        <h2 class="ps-h2 ps-pie__frase" data-ps-entra style="--ps-i:0">{{ section.settings.frase | newline_to_br }}</h2>
        {%- if section.settings.texto != blank -%}<p class="ps-pie__texto">{{ section.settings.texto }}</p>{%- endif -%}
        <div class="ps-pie__acciones" data-ps-entra style="--ps-i:1">
          {%- if wa != blank -%}
            <a class="ps-btn" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">{% render 'ps-icono', nombre: 'whatsapp', tam: 20 %}WhatsApp {{ section.settings.whatsapp_texto }}</a>
          {%- endif -%}
          <a class="ps-link" href="{{ section.settings.contacto | default: '/pages/contact' }}">O por el formulario</a>
        </div>
      </div>
      <a class="ps-pie__logo" data-ps-entra style="--ps-i:2" href="{{ routes.root_url }}" aria-label="{{ shop.name }}, ir a la portada">
        <img src="{{ 'ps-logo-oscuro.svg' | asset_url }}" width="1933" height="286" alt="" loading="lazy">
      </a>
    </div>
  </div>

  <div class="ps-wrap ps-pie__cols">
    {%- for i in (1..2) -%}
      {%- assign clave = 'menu_' | append: i -%}
      {%- assign menu = section.settings[clave] -%}
      {%- if menu != blank -%}
        <nav class="ps-pie__col" aria-label="{{ menu.title | escape }}">
          <h3 class="ps-pie__tit">{{ menu.title }}</h3>
          <ul role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.boletin -%}
      <div class="ps-pie__col ps-pie__boletin">
        <h3 class="ps-pie__tit">{{ section.settings.boletin_titulo }}</h3>
        <p class="ps-pie__nota" id="PsPieBoletin-ayuda">{{ section.settings.boletin_texto }}</p>
        {%- form 'customer', id: 'PsPieBoletin', class: 'ps-pie__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="ps-visually-hidden" for="PsPieCorreo">Correo electrónico</label>
          <div class="ps-pie__campo">
            <input id="PsPieCorreo" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" inputmode="email" autocapitalize="none" enterkeyhint="send" placeholder="Su correo electrónico" required aria-describedby="PsPieBoletin-ayuda{% if form.errors %} PsPieBoletin-msg{% endif %}"{% if form.errors %} aria-invalid="true"{% endif %}>
            <button type="submit">Apuntarme</button>
          </div>
          {%- if form.errors -%}
            <p class="ps-pie__msg ps-pie__msg--error" id="PsPieBoletin-msg" role="alert">Revise el correo: {{ form.errors.messages.email | downcase }}</p>
          {%- elsif form.posted_successfully? -%}
            <p class="ps-pie__msg" role="status">Hecho. Le avisaremos cuando bajemos precios.</p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  <div class="ps-pie__base">
    <div class="ps-wrap ps-pie__base-in">
      {%- if shop.enabled_payment_types.size > 0 -%}
        <ul class="ps-pie__pagos" role="list" aria-label="Formas de pago">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <div class="ps-pie__legal">
        <small>© {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
        {%- for policy in shop.policies -%}
          {%- if policy != blank -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.marcas != blank -%}<p class="ps-pie__marcas">{{ section.settings.marcas }}</p>{%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
/* La escena: la foto a todo el ancho, oscurecida por igual, con el titular
   arriba y el logo abajo. Después, en noche, menús, boletín y lo legal. */
.ps-pie__escena{position:relative;isolation:isolate;overflow:hidden;background:var(--ps-noche)}
.ps-pie__foto{position:absolute;inset:0;z-index:-1}
.ps-pie__img{width:100%;height:100%;object-fit:cover;object-position:50% 70%;filter:brightness(.5)}
.ps-pie .ps-pie__capa{display:flex;flex-direction:column;justify-content:space-between;gap:64px;min-height:100svh;padding-top:clamp(72px,9vw,128px);padding-bottom:clamp(40px,4.5vw,72px)}
.ps .ps-pie__frase{max-width:16ch;color:var(--ps-marfil)}
.ps-pie__texto{margin:20px 0 0;max-width:34ch;font-size:var(--ps-t3);line-height:1.5;color:var(--ps-marfil)}
.ps-pie__acciones{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:32px}
.ps-pie__logo{display:block;line-height:0;transition:opacity 160ms ease}
.ps-pie__logo img{width:100%;height:auto}
.ps-pie__logo:active{opacity:.8}

.ps-pie .ps-pie__cols{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.6fr);gap:40px clamp(32px,5vw,96px);padding-top:clamp(56px,6vw,88px);padding-bottom:clamp(48px,5vw,72px)}
.ps .ps-pie__tit{margin:0 0 14px;font-family:var(--ps-sans);font-size:var(--ps-t4);font-weight:700;letter-spacing:0;color:var(--ps-oro-texto)}
.ps-pie__col ul{list-style:none;margin:0;padding:0}
.ps-pie__col li + li{margin-top:4px}
.ps-pie__col a{display:inline-block;padding:5px 0;color:var(--ps-marfil);font-size:var(--ps-t4);text-decoration:none;text-underline-offset:5px;text-decoration-thickness:2px}
.ps-pie__col a[aria-current]{text-decoration:underline;text-decoration-color:var(--ps-oro)}
.ps-pie__nota{margin:0;max-width:40ch;font-size:var(--ps-t4);line-height:1.5;color:var(--ps-marfil-2)}
.ps-pie__form{margin-top:18px}
.ps-pie__campo{display:flex;align-items:center;max-width:460px;padding:5px;border-radius:999px;background:var(--ps-noche-2)}
.ps-pie__campo:focus-within{box-shadow:0 0 0 2px var(--ps-oro)}
.ps-pie__campo input{flex:1;min-width:0;height:48px;padding:0 18px;border:0;background:transparent;color:var(--ps-marfil);font:inherit;font-size:16px}
.ps-pie__campo input::placeholder{color:var(--ps-marfil-2);opacity:1}
.ps-pie__campo input:focus{outline:0}
.ps-pie__campo button{flex:none;height:48px;padding:0 22px;border:0;border-radius:999px;background:var(--ps-marfil);color:var(--ps-noche);font:inherit;font-size:16px;font-weight:700;cursor:pointer;transition:transform 120ms var(--ps-ease-out)}
.ps-pie__campo button:active{transform:scale(.97)}
.ps-pie__msg{margin:10px 0 0;font-size:var(--ps-t5);color:var(--ps-oro-texto)}
.ps-pie__msg--error{color:#f5b4b4}

.ps-pie__base{background:var(--ps-noche-2);padding:28px 0 calc(96px + env(safe-area-inset-bottom,0px))}
.ps-pie__base-in{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px 32px}
.ps-pie__pagos{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
.ps-pie__pagos svg{display:block;width:38px;height:24px}
.ps-pie__legal{display:flex;flex-wrap:wrap;align-items:center;gap:6px 20px;font-size:var(--ps-t5);color:var(--ps-marfil-2)}
.ps-pie__legal small{font-size:inherit}
.ps-pie__legal a{display:inline-block;padding:4px 0;color:inherit;text-decoration:none;text-underline-offset:4px}
.ps-pie__marcas{flex-basis:100%;margin:0;font-size:var(--ps-t5);line-height:1.5;color:var(--ps-marfil-2)}
@media (hover:hover) and (pointer:fine){
  .ps-pie__col a:hover{text-decoration:underline;text-decoration-color:var(--ps-oro)}
  .ps-pie__legal a:hover{color:var(--ps-marfil);text-decoration:underline}
  .ps-pie__campo button:hover{background:#fff}
}
@media (max-width:989px){
  .ps-pie .ps-pie__cols{grid-template-columns:1fr 1fr}
  .ps-pie__boletin{grid-column:1/-1}
}
@media (max-width:749px){
  .ps-pie .ps-pie__capa{min-height:88svh}
  .ps-pie__img{object-position:50% 62%}
  .ps-pie__acciones .ps-btn{width:100%}
  .ps-pie .ps-pie__cols{gap:36px 20px}
  .ps-pie__base-in{flex-direction:column;align-items:flex-start}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PS · Pie de página",
  "tag": "div",
  "class": "ps-section",
  "settings": [
    { "type": "image_picker", "id": "foto", "label": "Foto de fondo", "info": "Se oscurece sola para que el texto se lea. Elija una con lo importante en el centro." },
    { "type": "textarea", "id": "frase", "label": "Titular", "default": "¿Dudas? Escríbanos." },
    { "type": "textarea", "id": "texto", "label": "Texto bajo el titular", "default": "Escríbanos por WhatsApp con el modelo de su iPhone y le decimos qué necesita." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (con prefijo, sin +)", "default": "34641047539" },
    { "type": "text", "id": "whatsapp_texto", "label": "WhatsApp como se lee", "default": "641 04 75 39" },
    { "type": "url", "id": "contacto", "label": "Página de contacto", "info": "Si se deja vacío, /pages/contact." },
    { "type": "link_list", "id": "menu_1", "label": "Menú 1 (Tienda)" },
    { "type": "link_list", "id": "menu_2", "label": "Menú 2 (Ayuda)" },
    { "type": "checkbox", "id": "boletin", "label": "Boletín", "default": true },
    { "type": "text", "id": "boletin_titulo", "label": "Título del boletín", "default": "Avisos de precio" },
    { "type": "textarea", "id": "boletin_texto", "label": "Texto del boletín", "default": "Le escribimos solo cuando bajemos un precio." },
    { "type": "textarea", "id": "marcas", "label": "Nota de marcas", "default": "Apple, iPhone y Lightning son marcas de Apple Inc. Pillatumovil es un comercio independiente y no está afiliado a Apple." }
  ]
}
{% endschema %}
