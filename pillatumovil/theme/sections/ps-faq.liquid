{%- comment -%}
  Rediseño 2026 · PS · Preguntas.
  Titular ancho en grande y, debajo, las preguntas sangradas desde la
  columna 5: el hueco bajo el titular es la composición. Acordeón con
  details/summary (sin JavaScript); la fila abierta lleva un escalón de tono
  detrás. Cada pregunta es un bloque. Escribe también el FAQPage de
  schema.org.
{%- endcomment -%}
<section class="ps ps--{{ section.settings.fondo }} ps-sec ps-faq" aria-labelledby="PsFaq-{{ section.id }}">
  <div class="ps-wrap">
    <h2 class="ps-faq__tit" id="PsFaq-{{ section.id }}">{{ section.settings.titulo }}</h2>
    <div class="ps-faq__cuerpo">
      <div class="ps-faq__lista">
        {%- for block in section.blocks -%}
          <details class="ps-faq__item" {{ block.shopify_attributes }}{% if forloop.first and section.settings.abrir_primera %} open{% endif %}>
            <summary><span>{{ block.settings.pregunta }}</span><svg class="ps-faq__flecha" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg></summary>
            <div class="ps-faq__r">{{ block.settings.respuesta }}</div>
          </details>
        {%- endfor -%}
      </div>
      {%- if section.settings.texto != blank or section.settings.boton != blank -%}
        <div class="ps-faq__mas">
          {%- if section.settings.texto != blank -%}<p>{{ section.settings.texto }}</p>{%- endif -%}
          {%- if section.settings.boton != blank and section.settings.enlace != blank -%}
            <a class="ps-btn ps-btn--tinta" href="{{ section.settings.enlace }}">{% render 'ps-icono', nombre: 'whatsapp', tam: 20 %}{{ section.settings.boton }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.pregunta | json }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.respuesta | strip_html | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% stylesheet %}
.ps .ps-faq__tit{margin:0;font-family:var(--ps-display);font-weight:600;font-size:var(--ps-t1);line-height:1.02;letter-spacing:-.035em;max-width:14ch;text-wrap:balance}
.ps-faq__cuerpo{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));margin-top:80px}
.ps-faq__lista,.ps-faq__mas{grid-column:5 / -1}
.ps-faq__item{margin:0 -24px;padding:0 24px;transition:background-color 200ms ease}
.ps-faq__item + .ps-faq__item{margin-top:8px}
.ps-faq__item[open]{background:var(--ps-campo-2)}
.ps-faq__item summary{display:flex;align-items:center;justify-content:space-between;gap:24px;min-height:64px;padding:16px 0;cursor:pointer;list-style:none;font-size:var(--ps-t3);line-height:1.35;-webkit-user-select:none;user-select:none}
.ps-faq__item summary::-webkit-details-marker{display:none}
.ps-faq__flecha{flex:none;transition:transform 220ms var(--ps-ease-out)}
.ps-faq__item[open] .ps-faq__flecha{transform:rotate(180deg)}
.ps-faq__item summary:active span{opacity:.7}
.ps-faq__r{max-width:52ch;padding:0 0 24px;font-size:var(--ps-t4);line-height:1.6}
.ps-faq__r p{margin:0 0 10px}
.ps-faq__r a{color:inherit;text-decoration-color:var(--ps-oro);text-decoration-thickness:2px;text-underline-offset:4px}
.ps-faq__mas{display:flex;flex-wrap:wrap;align-items:center;gap:16px 28px;margin-top:48px}
.ps-faq__mas p{margin:0;font-size:var(--ps-t3)}
@media (max-width:989px){
  .ps-faq__cuerpo{display:block;margin-top:48px}
  .ps-faq__item{margin:0 calc(var(--ps-margen) * -1);padding:0 var(--ps-margen)}
  .ps-faq__item summary{font-size:19px}
}
@media (max-width:599px){.ps-faq__mas .ps-btn{width:100%}}
{% endstylesheet %}

{% schema %}
{
  "name": "PS · Preguntas",
  "tag": "div",
  "class": "ps-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "Lo que nos preguntan" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "¿Su duda no está?" },
    { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Escribir por WhatsApp" },
    { "type": "url", "id": "enlace", "label": "Enlace del botón", "info": "Si lo dejas vacío, el botón no sale." },
    { "type": "checkbox", "id": "abrir_primera", "label": "Primera pregunta abierta", "default": true },
    { "type": "select", "id": "fondo", "label": "Fondo", "default": "papel", "options": [
      { "value": "piedra", "label": "Piedra" }, { "value": "papel", "label": "Papel" }, { "value": "noche", "label": "Noche" } ] }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "Pregunta" },
        { "type": "richtext", "id": "respuesta", "label": "Respuesta", "default": "<p>Respuesta</p>" }
      ]
    }
  ],
  "presets": [{ "name": "PS · Preguntas" }]
}
{% endschema %}
