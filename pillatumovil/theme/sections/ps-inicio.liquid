{%- comment -%}
  Rediseño 2026 · PS · Inicio (primera pantalla de la portada).

  Dirección «El objeto, grande»: el vídeo de estudio de las dos cajas, grande
  y cortado por el borde derecho; a la izquierda, qué es (h1), el precio en
  letra enorme con «En Apple» y su fecha, y una sola acción: elegir su pack.
  Abajo a la derecha, dos tarjetas con los dos packs (el siguiente paso para
  quien ya sabe qué iPhone tiene).

  Rendimiento: la foto de espera es la imagen principal (carga primero, con
  prioridad alta). El vídeo no se pide hasta que la página ha cargado y solo
  si el sistema no pide menos movimiento; aparece encima de la foto cuando ya
  se está reproduciendo. Si iOS (bajo consumo) no deja reproducirlo, se queda
  la foto, sin botón de play.
{%- endcomment -%}
{%- liquid
  assign p = section.settings.producto
  assign poster = section.settings.poster
-%}
<section class="ps ps--noche ps-ini" aria-labelledby="PsIni-{{ section.id }}">
  <div class="ps-ini__media">
    {%- if poster != blank -%}
      {{ poster | image_url: width: 2400 | image_tag:
        class: 'ps-ini__poster', loading: 'eager', fetchpriority: 'high',
        widths: '600,900,1200,1600,2000,2400', sizes: '(min-width: 990px) 64vw, 100vw', alt: section.settings.poster_alt }}
    {%- endif -%}
    {%- if section.settings.video_url != blank -%}
      <video class="ps-ini__video" muted loop playsinline preload="none" aria-hidden="true"{% if poster != blank %} poster="{{ poster | image_url: width: 1200 }}"{% endif %}
        data-src="{{ section.settings.video_url }}"
        {%- if section.settings.video_movil != blank %} data-src-movil="{{ section.settings.video_movil }}"{% endif %}></video>
      <button type="button" class="ps-ini__pausa" aria-label="Pausar el vídeo" aria-pressed="false" hidden>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path class="ps-ini__i-pausa" d="M7 5h3v14H7zM14 5h3v14h-3z"/><path class="ps-ini__i-play" d="M8 5v14l11-7z"/></svg>
      </button>
    {%- endif -%}
  </div>

  <div class="ps-wrap ps-ini__wrap">
    <div class="ps-ini__texto">
      <h1 class="ps-ini__h1" id="PsIni-{{ section.id }}">{{ section.settings.titular | newline_to_br }}</h1>
      {%- if section.settings.texto != blank -%}<p class="ps-ini__lead">{{ section.settings.texto }}</p>{%- endif -%}

      {%- if p != blank -%}
        <div class="ps-ini__precio">
          {%- render 'ps-comparacion', precio: p.price_min, producto: p, tam: 'grande' -%}
          {%- if section.settings.precio_nota != blank -%}<p class="ps-ini__nota">{{ section.settings.precio_nota }}</p>{%- endif -%}
          {%- if settings.ps_lanzamiento -%}<p class="ps-ini__nota ps-ini__nota--oro">{{ settings.ps_lanzamiento_texto }}</p>{%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <p class="ps-ini__lead">Falta elegir el producto del precio (solo lo ve usted en el editor).</p>
      {%- endif -%}

      <div class="ps-btns ps-ini__btns">
        {%- if section.settings.boton != blank -%}
          <a class="ps-btn" href="{{ section.settings.boton_url | default: '#su-iphone' }}">{{ section.settings.boton }}</a>
        {%- endif -%}
        {%- assign ipn = section.settings.iphones -%}
        {%- if ipn != blank and ipn.products_count > 0 -%}
          {%- assign ipn_min = ipn.products | map: 'price_min' | sort | first -%}
          <a class="ps-link" href="{{ ipn.url }}">{{ section.settings.iphones_texto }} {{ ipn_min | money_without_currency }}&nbsp;€</a>
        {%- elsif section.settings.enlace != blank -%}
          <a class="ps-link" href="{{ section.settings.enlace_url | default: '/collections/cargadores-y-cables' }}">{{ section.settings.enlace }}</a>
        {%- endif -%}
      </div>
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="ps-ini__tarjetas" role="list" aria-label="{{ section.settings.tarjetas_titulo | escape }}">
        {%- for block in section.blocks limit: 2 -%}
          {%- liquid
            assign bp = block.settings.producto
            assign img = block.settings.imagen | default: bp.featured_image
            assign url = bp.url | default: block.settings.url
          -%}
          <li class="ps-ini__tar" {{ block.shopify_attributes }}>
            <a href="{{ url }}">
              <span class="ps-ini__tar-foto">
                {%- if img != blank -%}{{ img | image_url: width: 640 | image_tag: loading: 'lazy', widths: '320,480,640', sizes: '(min-width: 990px) 240px, 46vw', alt: '' }}{%- endif -%}
              </span>
              <span class="ps-ini__tar-pie">
                <span><strong>{{ block.settings.titulo }}</strong> <span class="ps-ini__tar-sub">{{ block.settings.subtitulo }}</span></span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  {%- if section.settings.video_url != blank -%}
    <script>
      (function () {
        var s = document.currentScript.closest('.ps-ini');
        var v = s && s.querySelector('.ps-ini__video');
        if (!v || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var empezar = function () {
          var movil = v.getAttribute('data-src-movil');
          v.src = movil && window.matchMedia('(max-width: 989px)').matches ? movil : v.getAttribute('data-src');
          v.addEventListener('playing', function () { v.classList.add('ps-ini__video--ya'); var bp = s.querySelector('.ps-ini__pausa'); if (bp) bp.hidden = false; }, { once: true });
          var pr = v.play();
          if (pr && pr.catch) pr.catch(function () { /* bajo consumo: se queda la foto */ });
        };
        if (document.readyState === 'complete') empezar(); else window.addEventListener('load', empezar, { once: true });
        var parado = false, bp = s.querySelector('.ps-ini__pausa');
        if (bp) bp.addEventListener('click', function () {
          parado = !parado; if (parado) v.pause(); else v.play().catch(function () {});
          bp.setAttribute('aria-pressed', parado ? 'true' : 'false');
          bp.setAttribute('aria-label', parado ? 'Reproducir el vídeo' : 'Pausar el vídeo');
        });
        document.addEventListener('visibilitychange', function () { if (document.hidden) v.pause(); else if (v.src && !parado) v.play().catch(function () {}); });
      })();
    </script>
  {%- endif -%}
</section>

{% stylesheet %}
.ps-ini{position:relative;isolation:isolate;overflow:hidden;display:flex;min-height:min(calc(100svh - 110px),900px)}
.ps-ini__media{position:absolute;inset:0 0 0 36%;z-index:-1;background:var(--ps-noche)}
.ps-ini__poster,.ps-ini__video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:62% 50%}
.ps-ini__video{opacity:0;transition:opacity 600ms ease}
.ps-ini__video--ya{opacity:1}
.ps-ini__pausa{position:absolute;right:16px;top:16px;z-index:2;display:grid;place-items:center;width:44px;height:44px;border:0;border-radius:999px;background:rgba(11,15,26,.6);color:#f4f1ea;cursor:pointer;transition:transform 120ms var(--ps-ease-out)}
.ps-ini__pausa:active{transform:scale(.92)}
.ps-ini__pausa .ps-ini__i-play,.ps-ini__pausa[aria-pressed="true"] .ps-ini__i-pausa{display:none}
.ps-ini__pausa[aria-pressed="true"] .ps-ini__i-play{display:inline}
.ps-ini__wrap{position:relative;display:flex;flex-direction:column;justify-content:center;padding-top:clamp(48px,6vw,96px);padding-bottom:clamp(40px,5vw,72px)}
.ps-ini__texto{max-width:600px}
.ps .ps-ini__h1{margin:0;font-family:var(--ps-display);font-weight:600;font-size:clamp(32px,3.7vw,58px);line-height:1.04;letter-spacing:-.035em;text-wrap:balance}
.ps-ini__lead{margin:20px 0 0;max-width:34ch;font-size:var(--ps-t3);line-height:1.5}
.ps-ini__precio{margin-top:clamp(28px,3.4vw,48px)}
.ps-ini__nota{margin:10px 0 0;font-size:var(--ps-t5);color:var(--ps-marfil-2)}
.ps-ini__nota--oro{color:var(--ps-oro-texto);font-weight:700}
.ps-ini__btns{margin-top:clamp(28px,3vw,40px)}
.ps-ini__tarjetas{position:absolute;right:var(--ps-margen);bottom:clamp(28px,3vw,48px);display:flex;gap:16px;list-style:none;margin:0;padding:0}
.ps-ini__tar{width:240px}
.ps-ini__tar a{display:block;color:var(--ps-tinta);text-decoration:none;transition:transform 140ms var(--ps-ease-out)}
.ps-ini__tar a:active{transform:scale(.97)}
.ps-ini__tar-foto{display:block;aspect-ratio:3/2;overflow:hidden;background:var(--ps-papel)}
.ps-ini__tar-foto img{width:100%;height:100%;object-fit:cover}
.ps-ini__tar-pie{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:48px;padding:8px 14px;background:var(--ps-marfil);font-size:15px;line-height:1.25}
.ps-ini__tar-pie strong{font-weight:700}
.ps-ini__tar-sub{display:block;color:var(--ps-tinta-2);font-size:14px}
.ps-ini__tar-pie svg{flex:none;transition:transform 160ms var(--ps-ease-out)}
@media (hover:hover) and (pointer:fine){.ps-ini__tar a:hover svg{transform:translateX(3px)}}
/* En el ordenador la caja manda: las tarjetas solo salen en el móvil (allí
   ahorran bajar hasta el selector). El borde izquierdo del vídeo se funde
   con la noche para que no se vea dónde empieza. */
@media (min-width:990px){
  .ps-ini__tarjetas{display:none}
  .ps-ini__media{-webkit-mask-image:linear-gradient(90deg,transparent 0,#000 14%);mask-image:linear-gradient(90deg,transparent 0,#000 14%)}
}
@media (max-width:989px){
  .ps-ini{display:block;min-height:0}
  .ps-ini__media{position:relative;inset:auto;aspect-ratio:1/1;max-height:62svh;width:100%}
  .ps-ini__poster,.ps-ini__video{object-position:50% 50%}
  .ps-ini__wrap{padding-top:40px;padding-bottom:40px}
  .ps-ini__tarjetas{position:static;margin-top:32px}
  .ps-ini__tar{width:auto;flex:1 1 0;min-width:0}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PS · Inicio",
  "tag": "div",
  "class": "ps-section",
  "max_blocks": 2,
  "settings": [
    { "type": "textarea", "id": "titular", "label": "Titular (h1)", "default": "Cargador y cable de Apple", "info": "Corto: dos líneas como mucho en el móvil." },
    { "type": "textarea", "id": "texto", "label": "Frase bajo el titular", "default": "Originales, nuevos y precintados. Para cualquier iPhone, con envío gratis en 24-48 h." },
    { "type": "product", "id": "producto", "label": "Producto del precio", "info": "Su precio, el de Apple (metacampo custom.pvp_apple) y el ahorro salen solos." },
    { "type": "text", "id": "precio_nota", "label": "Nota bajo el precio", "default": "El pack: adaptador de 20 W y cable de 1 m." },
    { "type": "text", "id": "boton", "label": "Botón", "default": "Elegir mi pack" },
    { "type": "url", "id": "boton_url", "label": "Enlace del botón", "info": "Vacío: baja a «¿Qué iPhone tiene?»." },
    { "type": "text", "id": "enlace", "label": "Enlace secundario", "default": "Ver todos los productos" },
    { "type": "url", "id": "enlace_url", "label": "Destino del enlace secundario" },
    { "type": "header", "content": "Vídeo y foto" },
    { "type": "image_picker", "id": "poster", "label": "Foto (sale primero y si el vídeo no se puede reproducir)" },
    { "type": "text", "id": "poster_alt", "label": "Descripción de la foto", "default": "Las cajas del adaptador de 20 W y del cable USB-C de Apple, sobre una piedra oscura" },
    { "type": "text", "id": "video_url", "label": "Enlace del vídeo (.mp4)", "info": "Súbalo en Contenido > Archivos como archivo y pegue aquí su enlace." },
    { "type": "text", "id": "video_movil", "label": "Vídeo para móvil (.mp4, cuadrado)" },
    { "type": "header", "content": "Tarjetas" },
    { "type": "collection", "id": "iphones", "label": "Colección de iPhone (enlace junto al botón)", "info": "Si se elige, el segundo enlace dice «También iPhone, desde …» con el precio más bajo de la colección, en lugar del enlace de arriba." },
    { "type": "text", "id": "iphones_texto", "label": "Texto del enlace de iPhone", "default": "También iPhone, desde" },
    { "type": "text", "id": "tarjetas_titulo", "label": "Nombre de las tarjetas (para lectores de pantalla)", "default": "Los dos packs" }
  ],
  "blocks": [
    {
      "type": "tarjeta",
      "name": "Tarjeta",
      "settings": [
        { "type": "product", "id": "producto", "label": "Producto" },
        { "type": "url", "id": "url", "label": "Enlace (si no hay producto)" },
        { "type": "image_picker", "id": "imagen", "label": "Foto (si no, la del producto)" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Pack USB-C" },
        { "type": "text", "id": "subtitulo", "label": "Para qué iPhone", "default": "iPhone 15 o posterior" }
      ]
    }
  ],
  "presets": [{ "name": "PS · Inicio" }]
}
{% endschema %}
