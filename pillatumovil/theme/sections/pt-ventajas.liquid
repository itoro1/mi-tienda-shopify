{%- comment -%}
  Garantias en forma de etiqueta de caja: dato y valor, sin iconos. Lo
  que el cliente necesita saber antes de comprar, dicho como un dato, no
  como un eslogan. Cada fila es un bloque.
{%- endcomment -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
<section class="pt pt-label-sec{% if section.settings.margen_arriba %} pt-label-sec--sep{% endif %}" style="--pt-accent:{{ settings.pt_accent | default: '#0e7c3a' }}">
  <div class="pt-wrap">
    <dl class="pt-label">
      {%- for block in section.blocks -%}
        <div class="pt-label__row" {{ block.shopify_attributes }}>
          <dt>{{ block.settings.dato }}</dt>
          <dd>{{ block.settings.valor }}</dd>
          {%- if block.settings.detalle != blank -%}<dd class="pt-label__more">{{ block.settings.detalle }}</dd>{%- endif -%}
        </div>
      {%- endfor -%}
    </dl>
  </div>
</section>

{% stylesheet %}
.pt-label-sec{padding:0 0 clamp(48px,6vw,80px)}
.pt-label-sec--sep{padding-top:clamp(32px,4vw,56px)}
.pt-label{margin:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));border:2px solid var(--pt-ink);border-radius:14px;overflow:hidden}
.pt-label__row{padding:18px 22px;border-left:2px solid var(--pt-ink);margin-left:-2px}
.pt-label dt{font-size:14px;color:var(--pt-muted)}
.pt-label dd{margin:2px 0 0;font-size:20px;font-weight:800;letter-spacing:-.015em;line-height:1.2}
.pt-label dd.pt-label__more{margin-top:6px;font-size:14px;font-weight:400;letter-spacing:0;color:var(--pt-muted)}
@media (max-width:749px){
  .pt-label{grid-template-columns:1fr 1fr}
  .pt-label__row{border-left:0;margin-left:0;border-top:2px solid var(--pt-ink);margin-top:-2px;padding:14px 16px}
  .pt-label__row:nth-child(even){border-left:2px solid var(--pt-ink)}
  .pt-label dd{font-size:17px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · Garantías",
  "tag": "div",
  "class": "pt-section",
  "max_blocks": 6,
  "settings": [
    { "type": "checkbox", "id": "margen_arriba", "label": "Separación arriba", "info": "Actívalo cuando la sección no vaya justo debajo de la portada.", "default": false }
  ],
  "blocks": [
    {
      "type": "dato",
      "name": "Dato",
      "settings": [
        { "type": "text", "id": "dato", "label": "Dato", "default": "Garantía" },
        { "type": "text", "id": "valor", "label": "Valor", "default": "3 años" },
        { "type": "text", "id": "detalle", "label": "Detalle (opcional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PT · Garantías",
      "blocks": [
        { "type": "dato", "settings": { "dato": "Producto", "valor": "Original de Apple", "detalle": "Nuevo, en su caja precintada" } },
        { "type": "dato", "settings": { "dato": "Garantía", "valor": "3 años", "detalle": "La legal para producto nuevo" } },
        { "type": "dato", "settings": { "dato": "Devolución", "valor": "14 días", "detalle": "Desde que lo recibe" } },
        { "type": "dato", "settings": { "dato": "Pago", "valor": "Cifrado", "detalle": "No vemos los datos de su tarjeta" } }
      ]
    }
  ]
}
{% endschema %}
