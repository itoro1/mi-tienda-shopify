{%- comment -%}
  Barra superior (sustituye a la barra de anuncios de Dawn) y estilo de la
  cabecera de toda la tienda.

  - Barra: los mensajes en fila en ordenador; en movil, de uno en uno con un
    fundido (el primero, el destacado, es el que queda fijo si el sistema
    pide reducir el movimiento).
  - Cabecera (rediseño 2026): barra lisa en noche, logo a la izquierda,
    subrayado en oro al pasar y en la página activa, burbuja del carrito en
    oro. Ya no es transparente sobre el vídeo ni lleva desenfoque.
{%- endcomment -%}
{%- assign n = section.blocks.size -%}
<script src="{{ 'ps-carrito.js' | asset_url }}" defer></script>
<div class="ps-barra" style="--ps-n:{{ n }}">
  <ul class="ps-barra__lista" role="list">
    {%- for block in section.blocks -%}
      <li class="ps-barra__item{% if block.settings.destacado %} ps-barra__item--destacado{% endif %}" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- render 'ps-icono', nombre: block.settings.icono, tam: 16 -%}
        {%- if block.settings.enlace != blank -%}<a href="{{ block.settings.enlace }}">{{ block.settings.texto }}</a>{%- else -%}<span>{{ block.settings.texto }}</span>{%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</div>

<style>
  /* Barra superior: oro plano (sin degradado), letra de texto a 14 px. */
  .ps-barra{position:relative;z-index:4;background:#c9a86a;color:#0b0f1a;font-family:var(--font-body-family);font-size:14px;line-height:1.2}
  .ps-barra__lista{list-style:none;margin:0 auto;padding:0 20px;max-width:1360px;min-height:38px;display:flex;align-items:center;justify-content:center;gap:10px 48px}
  .ps-barra__item{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
  .ps-barra__item a{color:inherit;text-decoration:underline;text-underline-offset:3px}
  .ps-barra__item--destacado{font-weight:700}
  .ps-barra__item svg{flex:none}
  @media (max-width:989px){
    .ps-barra__lista{position:relative;min-height:36px}
    .ps-barra__item{position:absolute;left:16px;right:16px;justify-content:center;opacity:0;animation:ps-barra calc(var(--ps-n) * 4s) infinite;animation-delay:calc(var(--i) * 4s)}
    @keyframes ps-barra{
      0%{opacity:0;transform:translateY(4px)}
      {% if n > 0 %}{{ 100.0 | divided_by: n | times: 0.08 | round: 2 }}{% else %}3{% endif %}%{opacity:1;transform:none}
      {% if n > 0 %}{{ 100.0 | divided_by: n | times: 0.92 | round: 2 }}{% else %}30{% endif %}%{opacity:1;transform:none}
      {% if n > 0 %}{{ 100.0 | divided_by: n | round: 2 }}{% else %}33{% endif %}%{opacity:0;transform:translateY(-4px)}
      100%{opacity:0}
    }
  }
  @media (max-width:989px) and (prefers-reduced-motion:reduce){
    .ps-barra__item{animation:none}
    .ps-barra__item:first-child{opacity:1}
  }

  /* Mismo ancho y margen que las secciones ps- (.ps-wrap: 1360 px y
     margen clamp(16px,4vw,56px)): menú, portada y ficha empiezan en la misma
     línea. En línea y antes del contenido, para que no salte al cargar. */
  :root{--page-width:136rem}
  .page-width:not(.page-width--narrow),
  .header:not(.drawer-menu).page-width{padding-left:clamp(16px,4vw,56px);padding-right:clamp(16px,4vw,56px)}

  /* Cabecera: barra lisa en noche. Logo, cuatro enlaces y los iconos.
     Sin cristal ni desenfoque (manda design-taste-frontend) y sin línea. */
  .section-header .header-wrapper{background:#0b0f1a;border:0}
  .section-header .header{padding-top:14px;padding-bottom:14px}
  .section-header .header__heading-logo{max-width:200px}
  .section-header .header__inline-menu{margin-left:24px}
  .section-header .header__menu-item{font-family:var(--font-body-family);font-size:15px;font-weight:500;letter-spacing:0;color:#f4f1ea;padding:12px 14px;transition:opacity 120ms ease}
  .section-header .header__menu-item span,
  .section-header .header__active-menu-item{position:relative;text-decoration:none}
  .section-header .header__menu-item span::after{content:"";position:absolute;left:0;right:0;bottom:-6px;height:2px;background:#c9a86a;transform:scaleX(0);transform-origin:left center;transition:transform 220ms cubic-bezier(.23,1,.32,1)}
  .section-header .header__menu-item .header__active-menu-item::after{transform:scaleX(1)}
  .section-header .header__menu-item:active{opacity:.7}
  .section-header .header__icon{color:#f4f1ea;transition:transform 120ms cubic-bezier(.23,1,.32,1)}
  .section-header .header__icon:active{transform:scale(.92)}
  .section-header .cart-count-bubble{background:#c9a86a;color:#0b0f1a;font-weight:700}
  @media (hover:hover) and (pointer:fine){
    .section-header .header__menu-item:hover span::after{transform:scaleX(1)}
    .section-header .header__menu-item:hover{color:#fff}
  }
  @media (max-width:989px){
    /* En el móvil: menú, logo, buscar y carrito. La cuenta va dentro del menú. */
    .section-header .header__icon--account{display:none}
    .section-header .header__heading-logo{max-width:150px}
  }
</style>

{% schema %}
{
  "name": "PS · Barra superior",
  "tag": "div",
  "class": "ps-section-barra",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "mensaje",
      "name": "Mensaje",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "default": "envio", "options": [
          { "value": "envio", "label": "Furgoneta" }, { "value": "devolucion", "label": "Devolución" },
          { "value": "garantia", "label": "Escudo" }, { "value": "original", "label": "Caja" }, { "value": "movil", "label": "Móvil" } ] },
        { "type": "text", "id": "texto", "label": "Texto", "default": "Lo recibe en casa en 24-48 h" },
        { "type": "url", "id": "enlace", "label": "Enlace (opcional)" },
        { "type": "checkbox", "id": "destacado", "label": "Destacado (en negrita)", "default": false }
      ]
    }
  ],
  "presets": [{ "name": "PS · Barra superior" }]
}
{% endschema %}
