{%- comment -%}
  "¿Que conector tiene su iPhone?". El cliente toca el puerto que se parece
  al de su iPhone y debajo aparece el producto que le vale.

  Sin JavaScript: cada opcion es un radio y la respuesta se muestra con
  :has(). En navegadores sin :has() se ven todas las respuestas a la vez,
  que sigue siendo correcto. El ancla #encuentra es a donde apunta el boton
  principal de la portada.
{%- endcomment -%}
{%- liquid
  assign con_producto = 0
  for block in section.blocks
    if block.settings.producto != blank
      assign con_producto = con_producto | plus: 1
    endif
  endfor
  assign mostrar = true
  if con_producto == 0 and request.design_mode == false
    assign mostrar = false
  endif
-%}
{%- if mostrar -%}
{{ 'pt-base.css' | asset_url | stylesheet_tag }}
<section id="encuentra" class="pt pt-sec pt-pick-sec pt--box" style="--pt-accent:{{ settings.pt_accent | default: '#c9a86a' }}">
  <div class="pt-wrap">
    <div class="pt-pick__head">
      <h2 class="pt-h2">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p class="pt-lead">{{ section.settings.texto }}</p>{%- endif -%}
    </div>

    <div class="pt-pick">
      <fieldset class="pt-pick__opts">
        <legend class="visually-hidden">{{ section.settings.titulo }}</legend>
        {%- assign marcado = false -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.producto == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          <input class="pt-pick__in" type="radio" name="pt-pick-{{ section.id }}" id="pt-o-{{ block.id }}" value="{{ block.id }}"{% unless marcado %} checked{% endunless %}>
          {%- assign marcado = true -%}
          <label class="pt-pick__opt" for="pt-o-{{ block.id }}" {{ block.shopify_attributes }}>
            <span class="pt-port pt-port--{{ block.settings.conector }}" aria-hidden="true"><i></i></span>
            <span class="pt-pick__models">{{ block.settings.modelos }}</span>
            <span class="pt-pick__note">{{ block.settings.nota }}</span>
          </label>
        {%- endfor -%}
      </fieldset>

      <div class="pt-pick__results" aria-live="polite">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.producto -%}
          {%- if p == blank and request.design_mode == false -%}{%- continue -%}{%- endif -%}
          <div class="pt-pick__res" data-res="{{ block.id }}">
            {%- if p != blank -%}
              <a class="pt-pick__img" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
                {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250, 500', sizes: '220px', alt: '' }}{%- endif -%}
              </a>
              <div class="pt-pick__info">
                <p class="pt-pick__for">Para {{ block.settings.modelos }}</p>
                <h3 class="pt-h3"><a href="{{ p.url }}">{{ p.title }}</a></h3>
                {%- if block.settings.incluye != blank -%}<p class="pt-pick__inc">{{ block.settings.incluye }}</p>{%- endif -%}
                {%- render 'pt-precio', product: p -%}
              </div>
              <a class="pt-btn pt-pick__btn" href="{{ p.url }}">{{ block.settings.boton | default: 'Ver este producto' }}</a>
            {%- else -%}
              <p class="pt-pick__empty">Falta elegir el producto de «{{ block.settings.modelos }}» en el editor de temas.</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.ayuda != blank -%}<p class="pt-pick__help">{{ section.settings.ayuda }}</p>{%- endif -%}
  </div>

  {%- comment -%} Una regla por opcion: muestra su respuesta cuando esta marcada. {%- endcomment -%}
  <style>
    @supports selector(:has(*)) {
      #shopify-section-{{ section.id }} .pt-pick__res { display: none; }
      {%- for block in section.blocks %}
      #shopify-section-{{ section.id }} .pt-pick:has(#pt-o-{{ block.id }}:checked) [data-res="{{ block.id }}"] { display: grid; }
      {%- endfor %}
    }
  </style>
</section>
{%- endif -%}

{% stylesheet %}
.pt-pick__head{max-width:640px;margin-bottom:clamp(28px,4vw,44px)}
.pt-pick__opts{border:0;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;min-width:0}
.pt-pick__in{position:absolute;opacity:0;width:1px;height:1px;pointer-events:none}
.pt-pick__opt{display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto auto;column-gap:18px;align-items:center;padding:20px;border-radius:var(--pt-r-panel);background:var(--pt-paper);border:3px solid transparent;cursor:pointer;transition:border-color .15s ease}
.pt-pick__opt:hover{border-color:var(--pt-line)}
.pt-pick__in:checked + .pt-pick__opt{border-color:var(--pt-ink)}
.pt-pick__in:focus-visible + .pt-pick__opt{outline:3px solid var(--pt-accent);outline-offset:3px}
.pt-pick__models{grid-column:2;font-size:20px;font-weight:800;letter-spacing:-.015em;line-height:1.2}
.pt-pick__note{grid-column:2;font-size:14px;color:var(--pt-muted)}

/* El puerto de carga visto de frente, a escala aproximada. */
.pt-port{grid-row:span 2;display:grid;place-items:center;width:84px;height:56px;border-radius:12px;background:var(--pt-box)}
.pt-port i{display:block;position:relative;background:var(--pt-ink)}
.pt-port--usbc i{width:52px;height:18px;border-radius:9px}
.pt-port--usbc i::after{content:"";position:absolute;left:10px;right:10px;top:7px;height:4px;border-radius:2px;background:#9aa1ab}
.pt-port--lightning i{width:46px;height:11px;border-radius:6px}
.pt-port--lightning i::after{content:"";position:absolute;left:8px;right:8px;top:4px;height:3px;background:repeating-linear-gradient(90deg,#9aa1ab 0 3px,transparent 3px 6px)}

.pt-pick__results{margin-top:14px}
.pt-pick__res{grid-template-columns:200px 1fr auto;gap:24px;align-items:center;padding:20px;border-radius:var(--pt-r-panel);background:var(--pt-paper);display:grid;animation:pt-show .25s ease}
.pt-pick__res + .pt-pick__res{margin-top:14px}
@keyframes pt-show{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.pt-pick__img{display:grid;place-items:center;aspect-ratio:1/1;border-radius:14px;background:var(--pt-box)}
.pt-pick__img img{width:100%;height:100%;object-fit:contain;mix-blend-mode:multiply}
.pt-pick__info{display:flex;flex-direction:column;gap:6px;min-width:0}
.pt-pick__for{margin:0;font-size:14px;font-weight:700;color:var(--pt-accent)}
.pt-pick__info .pt-h3 a{color:inherit;text-decoration:none}
.pt-pick__info .pt-h3 a:hover{text-decoration:underline;text-underline-offset:3px}
.pt-pick__inc{margin:0;font-size:15px;color:var(--pt-muted)}
.pt-pick__empty{grid-column:1/-1;margin:0;color:var(--pt-muted)}
.pt-pick__help{margin:24px 0 0;max-width:68ch;font-size:15px;color:var(--pt-muted)}
@media (max-width:749px){
  .pt-pick__res{grid-template-columns:96px 1fr;gap:14px 16px;padding:16px}
  .pt-pick__btn{grid-column:1/-1}
  .pt-port{width:64px;height:48px}
  .pt-port--usbc i{width:40px;height:14px}
  .pt-port--usbc i::after{top:5px;left:8px;right:8px}
  .pt-port--lightning i{width:36px;height:9px}
  .pt-port--lightning i::after{top:3px}
  .pt-pick__models{font-size:18px}
}
{% endstylesheet %}

{% schema %}
{
  "name": "PT · ¿Qué conector?",
  "tag": "div",
  "class": "pt-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "titulo", "label": "Título", "default": "¿Qué conector tiene su iPhone?" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Elija el que se parece al suyo y le mostramos el producto adecuado." },
    { "type": "text", "id": "ayuda", "label": "Nota al pie", "default": "Del iPhone 15 en adelante todos llevan USB-C. Del iPhone 8 al 14, Lightning." }
  ],
  "blocks": [
    {
      "type": "opcion",
      "name": "Tipo de iPhone",
      "settings": [
        { "type": "text", "id": "modelos", "label": "Modelos", "default": "iPhone 15 o posterior" },
        { "type": "select", "id": "conector", "label": "Dibujo del puerto", "default": "usbc", "options": [
          { "value": "usbc", "label": "USB-C" },
          { "value": "lightning", "label": "Lightning" }
        ]},
        { "type": "text", "id": "nota", "label": "Cómo reconocerlo", "default": "Puerto ovalado, como el de un Mac o un iPad" },
        { "type": "product", "id": "producto", "label": "Producto recomendado" },
        { "type": "text", "id": "incluye", "label": "Qué incluye (opcional)" },
        { "type": "text", "id": "boton", "label": "Texto del botón", "default": "Ver este producto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "PT · ¿Qué conector?",
      "blocks": [
        { "type": "opcion", "settings": { "modelos": "iPhone 15, 16, 17 o 18", "conector": "usbc", "nota": "Puerto ovalado, como el de un Mac o un iPad" } },
        { "type": "opcion", "settings": { "modelos": "iPhone 8 al 14", "conector": "lightning", "nota": "Puerto más fino y estrecho que el USB-C" } }
      ]
    }
  ]
}
{% endschema %}
